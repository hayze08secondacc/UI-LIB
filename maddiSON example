local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/hayze08secondacc/UI-LIB/refs/heads/main/maddiSON%20example"))()

local Window = Library:CreateWindow({
    Title = "loczur2 Hub",
    Subtitle = "maddiSON"
})

local Main = Window:CreateTab({
    Name = "Main"
})

local HomeSection = Main:CreateSection(
    "Home",
    "Example controls"
)

HomeSection:CreateLabel({
    Name = "Disclaimer",
    Description = "Usage notice",
    Text = "not responsible for any bans"
})

HomeSection:CreateButton({
    Name = "Show notification",
    Description = "Displays a test notification.",
    Callback = function()
        Window:Notify(
            "Notice",
            "Thanks for helping me",
            "success"
        )
    end
})

HomeSection:CreateToggle({
    Name = "Example toggle",
    Description = "Demonstrates a toggle.",
    Default = false,
    Callback = function(enabled)
        print("Toggle state:", enabled)
    end
})

HomeSection:CreateSlider({
    Name = "Example slider",
    Description = "Demonstrates a slider.",
    Minimum = 0,
    Maximum = 100,
    Default = 50,
    Callback = function(value)
        print("Slider value:", value)
    end
})

HomeSection:CreateDropdown({
    Name = "Example dropdown",
    Description = "Click to cycle through options.",
    Options = {
        "Option one",
        "Option two",
        "Option three"
    },
    Default = "Option one",
    Callback = function(selected)
        print("Selected:", selected)
    end
})

HomeSection:CreateKeybind({
    Name = "Notification key",
    Description = "Press the selected key.",
    Default = Enum.KeyCode.N,
    Callback = function()
        Window:Notify(
            "Keybind",
            "The keybind was pressed.",
            "info"
        )
    end
})

HomeSection:CreateTextbox({
    Name = "Name input",
    Description = "Enter some text.",
    Placeholder = "Type here...",
    Callback = function(text)
        print("Textbox text:", text)
    end
})
