--[[
    LIQUID MOG UI FRAMEWORK
    Features: Liquid Fades, Dropdowns, Keybinds, Sliders, Procedural Shadows
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local Library = {
    Theme = {
        Base = Color3.fromRGB(12, 12, 14),
        Container = Color3.fromRGB(18, 18, 22),
        Element = Color3.fromRGB(25, 25, 30),
        Hover = Color3.fromRGB(35, 35, 42),
        Accent = Color3.fromRGB(110, 80, 255),
        Text = Color3.fromRGB(240, 240, 240),
        DimText = Color3.fromRGB(140, 140, 150)
    }
}

local function Tween(obj, props, time)
    local tw = TweenService:Create(obj, TweenInfo.new(time or 0.25, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function ApplyLiquidShadow(parent)
    local folder = Instance.new("Folder", parent)
    folder.Name = "LiquidShadow"
    for i = 1, 5 do
        local shadow = Instance.new("Frame", folder)
        shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        shadow.BackgroundTransparency = 0.8 + (i * 0.03)
        shadow.BorderSizePixel = 0
        shadow.Size = UDim2.new(1, i * 6, 1, i * 6)
        shadow.Position = UDim2.new(0, -(i * 3), 0, -(i * 3))
        shadow.ZIndex = 0
        Instance.new("UICorner", shadow).CornerRadius = UDim.new(0, 10 + i)
    end
end

function Library:CreateLiquidWindow(title)
    local Window = {Tabs = {}, CurrentTab = nil}
    
    local GUI = Instance.new("ScreenGui")
    GUI.Name = "LiquidUI"
    GUI.ResetOnSpawn = false
    GUI.ZIndexBehavior = Enum.ZIndexBehavior.Global
    if gethui then GUI.Parent = gethui() else GUI.Parent = CoreGui end

    local Main = Instance.new("Frame", GUI)
    Main.Size = UDim2.new(0, 700, 0, 450)
    Main.Position = UDim2.new(0.5, -350, 0.5, -225)
    Main.BackgroundColor3 = Library.Theme.Base
    Main.BorderSizePixel = 0
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 12)
    ApplyLiquidShadow(Main)

    -- Smooth Dragging
    local dragging, dragStart, startPos
    Main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = Main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Tween(Main, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}, 0.1)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    local Sidebar = Instance.new("Frame", Main)
    Sidebar.Size = UDim2.new(0, 180, 1, 0)
    Sidebar.BackgroundColor3 = Library.Theme.Container
    Sidebar.BorderSizePixel = 0
    Instance.new("UICorner", Sidebar).CornerRadius = UDim.new(0, 12)
    
    local Title = Instance.new("TextLabel", Sidebar)
    Title.Size = UDim2.new(1, 0, 0, 50)
    Title.BackgroundTransparency = 1
    Title.Text = "  " .. title
    Title.TextColor3 = Library.Theme.Text
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 18
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local TabContainer = Instance.new("ScrollingFrame", Sidebar)
    TabContainer.Size = UDim2.new(1, 0, 1, -60)
    TabContainer.Position = UDim2.new(0, 0, 0, 50)
    TabContainer.BackgroundTransparency = 1
    TabContainer.ScrollBarThickness = 0
    Instance.new("UIListLayout", TabContainer).Padding = UDim.new(0, 5)

    local ContentArea = Instance.new("Frame", Main)
    ContentArea.Size = UDim2.new(1, -190, 1, -20)
    ContentArea.Position = UDim2.new(0, 190, 0, 10)
    ContentArea.BackgroundTransparency = 1

    function Window:CreateTab(name)
        local Tab = {}
        
        local TabBtn = Instance.new("TextButton", TabContainer)
        TabBtn.Size = UDim2.new(1, -20, 0, 35)
        TabBtn.Position = UDim2.new(0, 10, 0, 0)
        TabBtn.BackgroundColor3 = Library.Theme.Base
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text = "  " .. name
        TabBtn.TextColor3 = Library.Theme.DimText
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 14
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        -- CanvasGroup for Liquid Fading
        local TabContent = Instance.new("CanvasGroup", ContentArea)
        TabContent.Size = UDim2.new(1, 0, 1, 0)
        TabContent.BackgroundTransparency = 1
        TabContent.GroupTransparency = 1
        TabContent.Visible = false
        
        local Scroll = Instance.new("ScrollingFrame", TabContent)
        Scroll.Size = UDim2.new(1, 0, 1, 0)
        Scroll.BackgroundTransparency = 1
        Scroll.ScrollBarThickness = 2
        local ScrollLayout = Instance.new("UIListLayout", Scroll)
        ScrollLayout.Padding = UDim.new(0, 8)
        
        Window.Tabs[name] = {Btn = TabBtn, Content = TabContent, Layout = ScrollLayout}

        TabBtn.MouseButton1Click:Connect(function()
            if Window.CurrentTab == name then return end
            for tName, data in pairs(Window.Tabs) do
                if tName == name then
                    data.Content.Visible = true
                    Tween(data.Content, {GroupTransparency = 0}, 0.3)
                    Tween(data.Btn, {BackgroundTransparency = 0, TextColor3 = Library.Theme.Accent}, 0.2)
                else
                    Tween(data.Content, {GroupTransparency = 1}, 0.3).Completed:Connect(function()
                        if Window.CurrentTab ~= tName then data.Content.Visible = false end
                    end)
                    Tween(data.Btn, {BackgroundTransparency = 1, TextColor3 = Library.Theme.DimText}, 0.2)
                end
            end
            Window.CurrentTab = name
        end)

        if not Window.CurrentTab then
            Window.CurrentTab = name
            TabContent.Visible = true
            TabContent.GroupTransparency = 0
            TabBtn.BackgroundTransparency = 0
            TabBtn.TextColor3 = Library.Theme.Accent
        end

        function Tab:CreateToggle(tName, callback)
            local state = false
            local Frame = Instance.new("TextButton", Scroll)
            Frame.Size = UDim2.new(1, -10, 0, 40)
            Frame.BackgroundColor3 = Library.Theme.Element
            Frame.Text = ""
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)
            
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1, -70, 1, 0)
            Label.Position = UDim2.new(0, 15, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = tName
            Label.TextColor3 = Library.Theme.Text
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local Pill = Instance.new("Frame", Frame)
            Pill.Size = UDim2.new(0, 40, 0, 20)
            Pill.Position = UDim2.new(1, -55, 0.5, -10)
            Pill.BackgroundColor3 = Library.Theme.Base
            Instance.new("UICorner", Pill).CornerRadius = UDim.new(1, 0)

            local Knob = Instance.new("Frame", Pill)
            Knob.Size = UDim2.new(0, 16, 0, 16)
            Knob.Position = UDim2.new(0, 2, 0.5, -8)
            Knob.BackgroundColor3 = Library.Theme.DimText
            Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

            Frame.MouseButton1Click:Connect(function()
                state = not state
                Tween(Knob, {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = state and Library.Theme.Text or Library.Theme.DimText}, 0.25)
                Tween(Pill, {BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Base}, 0.25)
                callback(state)
            end)
        end

        function Tab:CreateSlider(sName, min, max, callback)
            local Frame = Instance.new("Frame", Scroll)
            Frame.Size = UDim2.new(1, -10, 0, 55)
            Frame.BackgroundColor3 = Library.Theme.Element
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1, -20, 0, 25)
            Label.Position = UDim2.new(0, 15, 0, 5)
            Label.BackgroundTransparency = 1
            Label.Text = sName
            Label.TextColor3 = Library.Theme.Text
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local ValLabel = Instance.new("TextLabel", Frame)
            ValLabel.Size = UDim2.new(0, 50, 0, 25)
            ValLabel.Position = UDim2.new(1, -65, 0, 5)
            ValLabel.BackgroundTransparency = 1
            ValLabel.Text = tostring(min)
            ValLabel.TextColor3 = Library.Theme.Accent
            ValLabel.Font = Enum.Font.GothamBold
            ValLabel.TextSize = 14
            ValLabel.TextXAlignment = Enum.TextXAlignment.Right

            local Track = Instance.new("TextButton", Frame)
            Track.Size = UDim2.new(1, -30, 0, 6)
            Track.Position = UDim2.new(0, 15, 0, 35)
            Track.BackgroundColor3 = Library.Theme.Base
            Track.Text = ""
            Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

            local Fill = Instance.new("Frame", Track)
            Fill.Size = UDim2.new(0, 0, 1, 0)
            Fill.BackgroundColor3 = Library.Theme.Accent
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local dragging = false
            local function update(input)
                local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local val = math.floor(min + ((max - min) * pos))
                ValLabel.Text = tostring(val)
                Tween(Fill, {Size = UDim2.new(pos, 0, 1, 0)}, 0.1)
                callback(val)
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; update(input) end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
            end)
        end

        function Tab:CreateDropdown(dName, options, callback)
            local open = false
            local Frame = Instance.new("Frame", Scroll)
            Frame.Size = UDim2.new(1, -10, 0, 40)
            Frame.BackgroundColor3 = Library.Theme.Element
            Frame.ClipsDescendants = true
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1, 0, 0, 40)
            Btn.BackgroundTransparency = 1
            Btn.Text = "  " .. dName
            Btn.TextColor3 = Library.Theme.Text
            Btn.Font = Enum.Font.Gotham
            Btn.TextSize = 14
            Btn.TextXAlignment = Enum.TextXAlignment.Left

            local Icon = Instance.new("TextLabel", Btn)
            Icon.Size = UDim2.new(0, 40, 1, 0)
            Icon.Position = UDim2.new(1, -40, 0, 0)
            Icon.BackgroundTransparency = 1
            Icon.Text = "+"
            Icon.TextColor3 = Library.Theme.Accent
            Icon.Font = Enum.Font.GothamBold
            Icon.TextSize = 18

            local DropList = Instance.new("Frame", Frame)
            DropList.Size = UDim2.new(1, -20, 1, -45)
            DropList.Position = UDim2.new(0, 10, 0, 40)
            DropList.BackgroundTransparency = 1
            local DLayout = Instance.new("UIListLayout", DropList)
            DLayout.Padding = UDim.new(0, 4)

            for _, opt in ipairs(options) do
                local OptBtn = Instance.new("TextButton", DropList)
                OptBtn.Size = UDim2.new(1, 0, 0, 30)
                OptBtn.BackgroundColor3 = Library.Theme.Base
                OptBtn.Text = opt
                OptBtn.TextColor3 = Library.Theme.DimText
                OptBtn.Font = Enum.Font.Gotham
                OptBtn.TextSize = 13
                Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 6)

                OptBtn.MouseButton1Click:Connect(function()
                    Btn.Text = "  " .. dName .. " : " .. opt
                    callback(opt)
                    open = false
                    Tween(Frame, {Size = UDim2.new(1, -10, 0, 40)}, 0.25)
                    Tween(Icon, {Rotation = 0}, 0.25)
                end)
            end

            Btn.MouseButton1Click:Connect(function()
                open = not open
                Tween(Frame, {Size = open and UDim2.new(1, -10, 0, 45 + (DLayout.AbsoluteContentSize.Y)) or UDim2.new(1, -10, 0, 40)}, 0.25)
                Tween(Icon, {Rotation = open and 45 or 0}, 0.25)
            end)
        end

        function Tab:CreateKeybind(kName, default, callback)
            local key = default
            local listening = false
            
            local Frame = Instance.new("Frame", Scroll)
            Frame.Size = UDim2.new(1, -10, 0, 40)
            Frame.BackgroundColor3 = Library.Theme.Element
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)
            
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1, -100, 1, 0)
            Label.Position = UDim2.new(0, 15, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = kName
            Label.TextColor3 = Library.Theme.Text
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local BindBtn = Instance.new("TextButton", Frame)
            BindBtn.Size = UDim2.new(0, 70, 0, 26)
            BindBtn.Position = UDim2.new(1, -85, 0.5, -13)
            BindBtn.BackgroundColor3 = Library.Theme.Base
            BindBtn.Text = key.Name
            BindBtn.TextColor3 = Library.Theme.Accent
            BindBtn.Font = Enum.Font.GothamBold
            BindBtn.TextSize = 12
            Instance.new("UICorner", BindBtn).CornerRadius = UDim.new(0, 6)

            BindBtn.MouseButton1Click:Connect(function()
                listening = true
                BindBtn.Text = "..."
                Tween(BindBtn, {BackgroundColor3 = Library.Theme.Hover}, 0.2)
            end)

            UserInputService.InputBegan:Connect(function(input)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    key = input.KeyCode
                    BindBtn.Text = key.Name
                    listening = false
                    Tween(BindBtn, {BackgroundColor3 = Library.Theme.Base}, 0.2)
                elseif not listening and input.KeyCode == key then
                    callback()
                end
            end)
        end
        
        -- Update Canvas Size
        ScrollLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Scroll.CanvasSize = UDim2.new(0, 0, 0, ScrollLayout.AbsoluteContentSize.Y + 20)
        end)

        return Tab
    end
    return Window
end

return Library
