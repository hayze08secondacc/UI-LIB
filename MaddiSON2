--  TAB & ELEMENT BUILDER ENGINE
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

function MaddiSON:CreateTab(name, icon)
    local theme = GetTheme()
    local tabObj = { Name = name, Elements = {} }

    local tabBtn = Create("TextButton", {
        Name = "Tab_" .. name,
        Parent = self.SidebarContent,
        Size = UDim2.new(0, 180, 0, 36),
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 0.8,
        Text = (icon or "• ") .. "  " .. name,
        TextColor3 = theme.TextSecondary,
        TextSize = 14,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 12,
    })

    local indicator = Create("Frame", {
        Name = "Indicator",
        Parent = tabBtn,
        Size = UDim2.new(0, 3, 0.6, 0),
        Position = UDim2.new(0, 0, 0.2, 0),
        BackgroundColor3 = theme.Accent,
        BackgroundTransparency = 1,
        ZIndex = 13,
    })

    local page = Create("ScrollingFrame", {
        Name = "Page_" .. name,
        Parent = self.Pages,
        Size = UDim2.new(1, -20, 1, -20),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 11,
    })

    local pageLayout = Create("UIListLayout", {
        Parent = page,
        Padding = UDim.new(0, 8),
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    Connect(pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
        page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 15)
    end)

    local function SelectTab()
        for _, t in pairs(self.Tabs) do
            t.Page.Visible = false
            FastTween(t.Button, {BackgroundTransparency = 0.8, TextColor3 = GetTheme().TextSecondary}, 0.2)
            FastTween(t.Indicator, {BackgroundTransparency = 1}, 0.2)
        end
        page.Visible = true
        FastTween(tabBtn, {BackgroundTransparency = 0.3, TextColor3 = GetTheme().TextPrimary}, 0.2)
        FastTween(indicator, {BackgroundTransparency = 0}, 0.2)
        self.ActiveTab = tabObj
    end

    Connect(tabBtn.MouseButton1Click, SelectTab)

    tabObj.Button = tabBtn
    tabObj.Page = page
    tabObj.Indicator = indicator
    table.insert(self.Tabs, tabObj)

    if #self.Tabs == 1 then SelectTab() end

    -- Element Constructors
    function tabObj:AddButton(options)
        options = options or {}
        local text = options.Name or "Button"
        local callback = options.Callback or function() end
        local theme = GetTheme()

        local btnFrame = Create("Frame", {
            Name = text,
            Parent = page,
            Size = UDim2.new(1, -10, 0, 40),
            BackgroundColor3 = theme.Surface,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            ZIndex = 12,
        })

        local btn = Create("TextButton", {
            Parent = btnFrame,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = theme.TextPrimary,
            TextSize = 14,
            Font = Enum.Font.GothamSemibold,
            ZIndex = 13,
        })

        Connect(btn.MouseEnter, function() FastTween(btnFrame, {BackgroundColor3 = theme.SurfaceHover}, 0.2) end)
        Connect(btn.MouseLeave, function() FastTween(btnFrame, {BackgroundColor3 = theme.Surface}, 0.2) end)
        Connect(btn.MouseButton1Click, function()
            FastTween(btnFrame, {BackgroundTransparency = 0.5}, 0.1)
            task.wait(0.1)
            FastTween(btnFrame, {BackgroundTransparency = 0.2}, 0.1)
            callback()
        end)

        table.insert(MaddiSON.Elements, {Name = text, Frame = btnFrame})
        return btnFrame
    end

    function tabObj:AddToggle(options)
        options = options or {}
        local text = options.Name or "Toggle"
        local default = options.Default or false
        local flag = options.Flag
        local callback = options.Callback or function() end
        local state = default
        local theme = GetTheme()

        local toggleFrame = Create("Frame", {
            Name = text,
            Parent = page,
            Size = UDim2.new(1, -10, 0, 40),
            BackgroundColor3 = theme.Surface,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            ZIndex = 12,
        })

        Create("TextLabel", {
            Parent = toggleFrame,
            Size = UDim2.new(1, -60, 1, 0),
            Position = UDim2.new(0, 15, 0, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = theme.TextPrimary,
            TextSize = 14,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 13,
        })

        local switch = Create("Frame", {
            Parent = toggleFrame,
            Size = UDim2.new(0, 42, 0, 22),
            Position = UDim2.new(1, -55, 0.5, -11),
            BackgroundColor3 = state and theme.Accent or theme.BackgroundSecondary,
            BorderSizePixel = 0,
            ZIndex = 13,
        })

        local knob = Create("Frame", {
            Parent = switch,
            Size = UDim2.new(0, 16, 0, 16),
            Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
            BackgroundColor3 = theme.TextPrimary,
            BorderSizePixel = 0,
            ZIndex = 14,
        })

        local btn = Create("TextButton", {
            Parent = toggleFrame,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
            ZIndex = 15,
        })

        local function UpdateState(val)
            state = val
            if flag then MaddiSON.Flags[flag] = state end
            FastTween(switch, {BackgroundColor3 = state and GetTheme().Accent or GetTheme().BackgroundSecondary}, 0.2)
            FastTween(knob, {Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)}, 0.2)
            callback(state)
        end

        Connect(btn.MouseButton1Click, function() UpdateState(not state) end)
        if flag then MaddiSON.Flags[flag] = state end

        table.insert(MaddiSON.Elements, {Name = text, Frame = toggleFrame})
        return {Set = UpdateState}
    end

    function tabObj:AddSlider(options)
        options = options or {}
        local text = options.Name or "Slider"
        local min = options.Min or 0
        local max = options.Max or 100
        local default = options.Default or min
        local flag = options.Flag
        local callback = options.Callback or function() end
        local theme = GetTheme()
        local value = math.clamp(default, min, max)

        local sliderFrame = Create("Frame", {
            Name = text,
            Parent = page,
            Size = UDim2.new(1, -10, 0, 50),
            BackgroundColor3 = theme.Surface,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            ZIndex = 12,
        })

        Create("TextLabel", {
            Parent = sliderFrame,
            Size = UDim2.new(0.6, 0, 0, 25),
            Position = UDim2.new(0, 15, 0, 2),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = theme.TextPrimary,
            TextSize = 14,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 13,
        })

        local valLabel = Create("TextLabel", {
            Parent = sliderFrame,
            Size = UDim2.new(0.3, 0, 0, 25),
            Position = UDim2.new(0.7, -15, 0, 2),
            BackgroundTransparency = 1,
            Text = tostring(value),
            TextColor3 = theme.AccentSecondary,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 13,
        })

        local track = Create("Frame", {
            Parent = sliderFrame,
            Size = UDim2.new(1, -30, 0, 6),
            Position = UDim2.new(0, 15, 1, -15),
            BackgroundColor3 = theme.BackgroundSecondary,
            BorderSizePixel = 0,
            ZIndex = 13,
        })

        local fill = Create("Frame", {
            Parent = track,
            Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 14,
        })

        local draggingSlider = false
        local function UpdateSlider(input)
            local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * pos)
            valLabel.Text = tostring(value)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            if flag then MaddiSON.Flags[flag] = value end
            callback(value)
        end

        Connect(track.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSlider = true
                UpdateSlider(input)
            end
        end)

        Connect(UserInputService.InputChanged, function(input)
            if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
                UpdateSlider(input)
            end
        end)

        Connect(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end
        end)

        if flag then MaddiSON.Flags[flag] = value end
        table.insert(MaddiSON.Elements, {Name = text, Frame = sliderFrame})
    end

    function tabObj:AddDropdown(options)
        options = options or {}
        local text = options.Name or "Dropdown"
        local items = options.Options or {}
        local default = options.Default
        local flag = options.Flag
        local callback = options.Callback or function() end
        local theme = GetTheme()
        local expanded = false

        local dropFrame = Create("Frame", {
            Name = text,
            Parent = page,
            Size = UDim2.new(1, -10, 0, 40),
            BackgroundColor3 = theme.Surface,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            ZIndex = 12,
        })

        local header = Create("TextButton", {
            Parent = dropFrame,
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundTransparency = 1,
            Text = "",
            ZIndex = 13,
        })

        Create("TextLabel", {
            Parent = header,
            Size = UDim2.new(0.5, 0, 1, 0),
            Position = UDim2.new(0, 15, 0, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = theme.TextPrimary,
            TextSize = 14,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 14,
        })

        local selectedLabel = Create("TextLabel", {
            Parent = header,
            Size = UDim2.new(0.4, -20, 1, 0),
            Position = UDim2.new(0.5, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = default or "Select...",
            TextColor3 = theme.AccentSecondary,
            TextSize = 13,
            Font = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 14,
        })

        local arrow = Create("TextLabel", {
            Parent = header,
            Size = UDim2.new(0, 20, 1, 0),
            Position = UDim2.new(1, -25, 0, 0),
            BackgroundTransparency = 1,
            Text = "▼",
            TextColor3 = theme.TextMuted,
            TextSize = 12,
            ZIndex = 14,
        })

        local container = Create("Frame", {
            Parent = dropFrame,
            Size = UDim2.new(1, -20, 0, #items * 30),
            Position = UDim2.new(0, 10, 0, 40),
            BackgroundTransparency = 1,
            ZIndex = 14,
        })

        Create("UIListLayout", { Parent = container, Padding = UDim.new(0, 2) })

        for _, item in ipairs(items) do
            local itemBtn = Create("TextButton", {
                Parent = container,
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundColor3 = theme.BackgroundTertiary,
                BackgroundTransparency = 0.5,
                Text = item,
                TextColor3 = theme.TextSecondary,
                TextSize = 13,
                Font = Enum.Font.Gotham,
                ZIndex = 15,
            })

            Connect(itemBtn.MouseButton1Click, function()
                selectedLabel.Text = item
                if flag then MaddiSON.Flags[flag] = item end
                callback(item)
                expanded = false
                FastTween(dropFrame, {Size = UDim2.new(1, -10, 0, 40)}, 0.2)
                arrow.Text = "▼"
            end)
        end

        Connect(header.MouseButton1Click, function()
            expanded = not expanded
            FastTween(dropFrame, {Size = expanded and UDim2.new(1, -10, 0, 45 + #items * 30) or UDim2.new(1, -10, 0, 40)}, 0.2)
            arrow.Text = expanded and "▲" or "▼"
        end)

        table.insert(MaddiSON.Elements, {Name = text, Frame = dropFrame})
    end

    function tabObj:AddKeybind(options)
        options = options or {}
        local text = options.Name or "Keybind"
        local default = options.Default or Enum.KeyCode.E
        local callback = options.Callback or function() end
        local theme = GetTheme()
        local currentKey = default
        local binding = false

        local keyFrame = Create("Frame", {
            Name = text,
            Parent = page,
            Size = UDim2.new(1, -10, 0, 40),
            BackgroundColor3 = theme.Surface,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            ZIndex = 12,
        })

        Create("TextLabel", {
            Parent = keyFrame,
            Size = UDim2.new(0.6, 0, 1, 0),
            Position = UDim2.new(0, 15, 0, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = theme.TextPrimary,
            TextSize = 14,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 13,
        })

        local keyBtn = Create("TextButton", {
            Parent = keyFrame,
            Size = UDim2.new(0, 80, 0, 24),
            Position = UDim2.new(1, -95, 0.5, -12),
            BackgroundColor3 = theme.BackgroundTertiary,
            Text = currentKey.Name,
            TextColor3 = theme.AccentSecondary,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            ZIndex = 13,
        })

        Connect(keyBtn.MouseButton1Click, function()
            binding = true
            keyBtn.Text = "..."
        end)

        Connect(UserInputService.InputBegan, function(input, gpe)
            if binding and input.UserInputType == Enum.UserInputType.Keyboard then
                binding = false
                currentKey = input.KeyCode
                keyBtn.Text = currentKey.Name
            elseif not gpe and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey then
                callback(currentKey)
            end
        end)

        table.insert(MaddiSON.Elements, {Name = text, Frame = keyFrame})
    end

    return tabObj
end

-- Theme Switcher API
function MaddiSON:SetTheme(themeName)
    if self.Themes[themeName] then
        self.CurrentTheme = themeName
        local theme = self.Themes[themeName]
        self.MainFrame.BackgroundColor3 = theme.Background
        self.TopBar.BackgroundColor3 = theme.BackgroundSecondary
        self.Sidebar.BackgroundColor3 = theme.BackgroundSecondary
        self.TopBarAccent.BackgroundColor3 = theme.Accent
        GeometricBackground:UpdateTheme()
    end
end

function MaddiSON:Notify(options)
    NotificationSystem:Notify(options)
end

return MaddiSON
