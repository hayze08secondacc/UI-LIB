    optionsLayout.Padding = UDim.new(0, 2)
    optionsLayout.Parent = optionsFrame
    
    local open = false
    
    for _, option in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, 0, 0, 32)
        optBtn.BackgroundColor3 = CurrentTheme.Surface
        optBtn.Text = option
        optBtn.TextColor3 = CurrentTheme.TextDim
        optBtn.TextSize = 14
        optBtn.Font = Enum.Font.Gotham
        optBtn.AutoButtonColor = false
        optBtn.ZIndex = 16
        optBtn.Parent = optionsFrame
        
        optBtn.MouseEnter:Connect(function()
            self:Tween(optBtn, {BackgroundColor3 = Color3.fromRGB(CurrentTheme.Surface.R * 255 + 20, CurrentTheme.Surface.G * 255 + 20, CurrentTheme.Surface.B * 255 + 20)}, 0.2)
            optBtn.TextColor3 = CurrentTheme.Text
        end)
        
        optBtn.MouseLeave:Connect(function()
            self:Tween(optBtn, {BackgroundColor3 = CurrentTheme.Surface}, 0.2)
            optBtn.TextColor3 = CurrentTheme.TextDim
        end)
        
        optBtn.MouseButton1Click:Connect(function()
            btn.Text = option .. "   ▼"
            callback(option)
            open = false
            self:Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.3)
            task.wait(0.3)
            optionsFrame.Visible = false
        end)
    end
    
    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            optionsFrame.Visible = true
            self:Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, #options * 34)}, 0.3, Enum.EasingStyle.Back)
            btn.Text = text .. "   ▲"
        else
            self:Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.3)
            task.wait(0.3)
            optionsFrame.Visible = false
            btn.Text = text .. "   ▼"
        end
    end)
    
    return container
end

function RicharliSON:CreateNotification(config)
    config = config or {}
    local text = config.Text or "Notification"
    local type = config.Type or "Info" -- Info, Success, Warning, Error
    local duration = config.Duration or 3
    
    local colors = {
        Info = CurrentTheme.Primary,
        Success = CurrentTheme.Success,
        Warning = CurrentTheme.Warning,
        Error = CurrentTheme.Error
    }
    
    local icons = {
        Info = "ℹ",
        Success = "✓",
        Warning = "⚠",
        Error = "✕"
    }
    
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    
    local notifGui = Instance.new("ScreenGui")
    notifGui.Name = "RicharliSON_Notification"
    notifGui.ResetOnSpawn = false
    notifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    notifGui.Parent = playerGui
    
    local notifFrame = Instance.new("Frame")
    notifFrame.Size = UDim2.new(0, 320, 0, 70)
    notifFrame.Position = UDim2.new(1, 20, 0.9, 0)
    notifFrame.BackgroundColor3 = CurrentTheme.Surface
    notifFrame.BorderSizePixel = 0
    notifFrame.ZIndex = 100
    notifFrame.Parent = notifGui
    self:CreateCorner(notifFrame, UDim.new(0, 12))
    self:CreateStroke(notifFrame, colors[type], 2, 0.3)
    
    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 40, 0, 40)
    icon.Position = UDim2.new(0, 15, 0.5, -20)
    icon.BackgroundColor3 = colors[type]
    icon.Text = icons[type]
    icon.TextColor3 = Color3.fromRGB(255, 255, 255)
    icon.TextSize = 20
    icon.Font = Enum.Font.GothamBold
    icon.ZIndex = 101
    icon.Parent = notifFrame
    self:CreateCorner(icon, UDim.new(0, 10))
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -75, 1, -20)
    label.Position = UDim2.new(0, 65, 0, 10)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = CurrentTheme.Text
    label.TextSize = 15
    label.Font = Enum.Font.GothamMedium
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 101
    label.Parent = notifFrame
    
    -- Animation entrée
    self:Tween(notifFrame, {Position = UDim2.new(1, -340, 0.9, 0)}, 0.6, Enum.EasingStyle.Back)
    
    -- Barre de progression
    local progress = Instance.new("Frame")
    progress.Size = UDim2.new(1, 0, 0, 3)
    progress.Position = UDim2.new(0, 0, 1, -3)
    progress.BackgroundColor3 = colors[type]
    progress.BorderSizePixel = 0
    progress.ZIndex = 102
    progress.Parent = notifFrame
    
    self:Tween(progress, {Size = UDim2.new(0, 0, 0, 3)}, duration)
    
    task.wait(duration)
    
    -- Animation sortie
    self:Tween(notifFrame, {Position = UDim2.new(1, 20, 0.9, 0)}, 0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In, function()
        notifGui:Destroy()
    end)
end

return RicharliSON
