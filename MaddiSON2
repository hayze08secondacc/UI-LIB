local CurrentPage

local function CreatePage(name)
    local page = New("Frame", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 13
    }, PageContainer)

    New("UIListLayout", {
        Padding = UDim.new(0, 12),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, page)

    Pages[name] = page
    return page
end

local function SelectPage(name)
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for buttonName, button in pairs(CategoryButtons) do
        local active = buttonName == name
        Tween(button, 0.2, {
            BackgroundColor3 = active and Theme.AccentDark or Theme.Element,
            TextColor3 = active and Theme.Text or Theme.SubText
        })

        local bar = button:FindFirstChild("ActiveBar")
        if bar then
            Tween(bar, 0.2, {
                BackgroundTransparency = active and 0 or 1
            })
        end
    end

    PageTitle.Text = name
    PageSubtitle.Text = ({
        Overview = "Configure your interface with precision.",
        Controls = "Buttons, toggles, sliders and keybinds.",
        Appearance = "Change the visual language of MaddiSON.",
        Utilities = "Useful tools and interface actions."
    })[name] or "MaddiSON interface module."

    CurrentPage = name
end

