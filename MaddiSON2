local function Notify(title, message, kind)
    local accent = Theme.White

    if kind == "success" then
        accent = Theme.Green
    elseif kind == "error" then
        accent = Theme.Red
    end

    local notification = New("Frame", {
        Size = UDim2.fromOffset(290, 70),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
        ZIndex = 101
    }, NotificationHolder)

    Corner(notification, 10)
    AddStroke(notification, Theme.Border, 1, 0.1)

    local accentBar = New("Frame", {
        Position = UDim2.fromOffset(0, 12),
        Size = UDim2.fromOffset(3, 46),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        ZIndex = 102
    }, notification)

    Corner(accentBar, 3)

    New("TextLabel", {
        Position = UDim2.fromOffset(17, 12),
        Size = UDim2.new(1, -30, 0, 17),
        BackgroundTransparency = 1,
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 102
    }, notification)

    New("TextLabel", {
        Position = UDim2.fromOffset(17, 33),
        Size = UDim2.new(1, -30, 0, 24),
        BackgroundTransparency = 1,
        Text = message,
        Font = Enum.Font.Gotham,
        TextSize = 9,
        TextColor3 = Theme.TextSoft,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 102
    }, notification)

    notification.Position = UDim2.fromOffset(320, 0)

    Tween(notification, 0.35, {
        Position = UDim2.fromOffset(0, 0)
    }, Enum.EasingStyle.Back)

    task.delay(3.2, function()
        Tween(notification, 0.3, {
            Position = UDim2.fromOffset(320, 0),
            BackgroundTransparency = 1
        })

        task.wait(0.35)

        if notification then
            notification:Destroy()
        end
    end)
end

