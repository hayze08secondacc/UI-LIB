--  GEOMETRIC BACKGROUND ENGINE
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

local GeometricBackground = {}
GeometricBackground.Shapes = {}
GeometricBackground.Particles = {}
GeometricBackground.Active = true

function GeometricBackground:Init(parent)
    self.Container = Create("Frame", {
        Name = "GeometricBackground",
        Parent = parent,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = GetTheme().Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 1,
    })

    self.GradientOverlay = Create("Frame", {
        Name = "GradientOverlay",
        Parent = self.Container,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 2,
    })

    self.Gradient1 = Create("Frame", {
        Name = "Gradient1",
        Parent = self.GradientOverlay,
        Size = UDim2.new(2, 0, 2, 0),
        Position = UDim2.new(-0.5, 0, -0.5, 0),
        BackgroundColor3 = GetTheme().Accent,
        BackgroundTransparency = 0.92,
        BorderSizePixel = 0,
        Rotation = 45,
        ZIndex = 2,
    })

    self.Gradient2 = Create("Frame", {
        Name = "Gradient2",
        Parent = self.GradientOverlay,
        Size = UDim2.new(2, 0, 2, 0),
        Position = UDim2.new(-0.5, 0, -0.5, 0),
        BackgroundColor3 = GetTheme().AccentSecondary,
        BackgroundTransparency = 0.94,
        BorderSizePixel = 0,
        Rotation = -30,
        ZIndex = 2,
    })

    for i = 1, 12 do
        local shape = Create("Frame", {
            Name = "Shape_" .. i,
            Parent = self.Container,
            Size = UDim2.new(0, math.random(80, 250), 0, math.random(80, 250)),
            Position = UDim2.new(math.random(), 0, math.random(), 0),
            BackgroundColor3 = i % 2 == 0 and GetTheme().Geometric1 or GetTheme().Geometric2,
            BackgroundTransparency = 0.94,
            BorderSizePixel = 0,
            Rotation = math.random(0, 360),
            ZIndex = 1,
        })

        local inner = Create("Frame", {
            Name = "Inner",
            Parent = shape,
            Size = UDim2.new(0.6, 0, 0.6, 0),
            Position = UDim2.new(0.2, 0, 0.2, 0),
            BackgroundColor3 = GetTheme().Geometric3,
            BackgroundTransparency = 0.9,
            BorderSizePixel = 0,
            ZIndex = 1,
        })

        table.insert(self.Shapes, {
            Instance = shape,
            Inner = inner,
            Speed = math.random(5, 20) / 100,
            RotSpeed = math.random(-30, 30) / 10,
            DriftX = math.random(-50, 50) / 1000,
            DriftY = math.random(-50, 50) / 1000,
            BaseTransparency = 0.94,
            PulseSpeed = math.random(10, 30) / 10,
            Offset = math.random() * math.pi * 2,
        })
    end

    for i = 1, 30 do
        local particle = Create("Frame", {
            Name = "Particle_" .. i,
            Parent = self.Container,
            Size = UDim2.new(0, math.random(2, 6), 0, math.random(2, 6)),
            Position = UDim2.new(math.random(), 0, math.random(), 0),
            BackgroundColor3 = GetTheme().Accent,
            BackgroundTransparency = math.random(30, 70) / 100,
            BorderSizePixel = 0,
            ZIndex = 2,
        })

        table.insert(self.Particles, {
            Instance = particle,
            SpeedY = math.random(10, 40) / 1000,
            SpeedX = math.random(-20, 20) / 1000,
            Wobble = math.random(10, 50) / 1000,
            WobbleSpeed = math.random(5, 15) / 10,
            Offset = math.random() * math.pi * 2,
        })
    end

    self.Connection = Connect(RunService.RenderStepped, function(dt)
        if not self.Active then return end
        local time = tick()
        local theme = GetTheme()

        for _, shapeData in ipairs(self.Shapes) do
            local shape = shapeData.Instance
            local inner = shapeData.Inner

            shape.Rotation = shape.Rotation + shapeData.RotSpeed * dt * 10
            local currentPos = shape.Position
            shape.Position = UDim2.new(currentPos.X.Scale + shapeData.DriftX * dt, 0, currentPos.Y.Scale + shapeData.DriftY * dt, 0)

            if shape.Position.X.Scale > 1.2 then shape.Position = UDim2.new(-0.2, 0, shape.Position.Y.Scale, 0)
            elseif shape.Position.X.Scale < -0.2 then shape.Position = UDim2.new(1.2, 0, shape.Position.Y.Scale, 0) end
            if shape.Position.Y.Scale > 1.2 then shape.Position = UDim2.new(shape.Position.X.Scale, 0, -0.2, 0)
            elseif shape.Position.Y.Scale < -0.2 then shape.Position = UDim2.new(shape.Position.X.Scale, 0, 1.2, 0) end

            local pulse = math.sin(time * shapeData.PulseSpeed + shapeData.Offset) * 0.03
            shape.BackgroundTransparency = shapeData.BaseTransparency + pulse
            inner.BackgroundTransparency = 0.9 + pulse
        end

        for _, particleData in ipairs(self.Particles) do
            local particle = particleData.Instance
            local wobble = math.sin(time * particleData.WobbleSpeed + particleData.Offset) * particleData.Wobble
            local currentPos = particle.Position
            particle.Position = UDim2.new(currentPos.X.Scale + (particleData.SpeedX + wobble) * dt, 0, currentPos.Y.Scale - particleData.SpeedY * dt, 0)

            if particle.Position.Y.Scale < -0.05 then
                particle.Position = UDim2.new(math.random(), 0, 1.05, 0)
                particle.BackgroundColor3 = theme.Accent
            end
        end

        self.Gradient1.Rotation = 45 + math.sin(time * 0.2) * 15
        self.Gradient2.Rotation = -30 + math.cos(time * 0.15) * 10
    end)
end

function GeometricBackground:UpdateTheme()
    local theme = GetTheme()
    self.Container.BackgroundColor3 = theme.Background
    self.Gradient1.BackgroundColor3 = theme.Accent
    self.Gradient2.BackgroundColor3 = theme.AccentSecondary
    for _, shapeData in ipairs(self.Shapes) do
        shapeData.Instance.BackgroundColor3 = theme.Geometric1
        shapeData.Inner.BackgroundColor3 = theme.Geometric3
    end
    for _, particleData in ipairs(self.Particles) do
        particleData.Instance.BackgroundColor3 = theme.Accent
    end
end

