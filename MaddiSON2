    SearchBG.BackgroundColor3 = Library.Theme.Background
    Instance.new("UICorner", SearchBG).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", SearchBG).Color = Library.Theme.Element
    
    local SearchBox = Instance.new("TextBox", SearchBG)
    SearchBox.Size = UDim2.new(1, -30, 1, 0)
    SearchBox.Position = UDim2.new(0, 30, 0, 0)
    SearchBox.BackgroundTransparency = 1
    SearchBox.Text = "Search..."
    SearchBox.TextColor3 = Library.Theme.SubText
    SearchBox.TextXAlignment = Enum.TextXAlignment.Left
    SearchBox.Font = Enum.Font.Gotham

    -- Profile Area (Bottom Left)
    local ProfileArea = Instance.new("Frame", Sidebar)
    ProfileArea.Size = UDim2.new(1, 0, 0, 60)
    ProfileArea.Position = UDim2.new(0, 0, 1, -60)
    ProfileArea.BackgroundTransparency = 1
    local Line = Instance.new("Frame", ProfileArea)
    Line.Size = UDim2.new(1, -30, 0, 1)
    Line.Position = UDim2.new(0, 15, 0, 0)
    Line.BackgroundColor3 = Library.Theme.Element
    Line.BorderSizePixel = 0
    
    local ProfileText = Instance.new("TextLabel", ProfileArea)
    ProfileText.Size = UDim2.new(1, -50, 1, -10)
    ProfileText.Position = UDim2.new(0, 50, 0, 10)
    ProfileText.BackgroundTransparency = 1
    ProfileText.Text = "tayex\n<font color='#999999'>99 days remaining</font>"
    ProfileText.RichText = true
    ProfileText.TextColor3 = Library.Theme.Text
    ProfileText.Font = Enum.Font.GothamMedium
    ProfileText.TextXAlignment = Enum.TextXAlignment.Left

    -- Tab Container
    local TabList = Instance.new("ScrollingFrame", Sidebar)
    TabList.Size = UDim2.new(1, 0, 1, -145)
    TabList.Position = UDim2.new(0, 0, 0, 85)
    TabList.BackgroundTransparency = 1
    TabList.ScrollBarThickness = 0
    local TabListLayout = Instance.new("UIListLayout", TabList)
    TabListLayout.Padding = UDim.new(0, 5)
    TabListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local ContentArea = Instance.new("Frame", Main)
    ContentArea.Size = UDim2.new(1, -200, 1, 0)
    ContentArea.Position = UDim2.new(0, 200, 0, 0)
    ContentArea.BackgroundTransparency = 1

    -- [ TABS SYSTEM ]
    function Window:CreateTab(name)
        local Tab = {}
        
        local TabBtn = Instance.new("TextButton", TabList)
        TabBtn.Size = UDim2.new(1, -30, 0, 35)
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text = "   " .. name
        TabBtn.TextColor3 = Library.Theme.SubText
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 14
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        local TabContent = Instance.new("ScrollingFrame", ContentArea)
        TabContent.Size = UDim2.new(1, -20, 1, -20)
        TabContent.Position = UDim2.new(0, 10, 0, 10)
        TabContent.BackgroundTransparency = 1
        TabContent.ScrollBarThickness = 2
        TabContent.Visible = false

        -- Layout for Left/Right Sections (Like the Image)
        local LeftCol = Instance.new("Frame", TabContent)
        LeftCol.Size = UDim2.new(0.5, -5, 1, 0)
        LeftCol.BackgroundTransparency = 1
        local RightCol = Instance.new("Frame", TabContent)
        RightCol.Size = UDim2.new(0.5, -5, 1, 0)
        RightCol.Position = UDim2.new(0.5, 5, 0, 0)
        RightCol.BackgroundTransparency = 1
        
        Instance.new("UIListLayout", LeftCol).Padding = UDim.new(0, 10)
        Instance.new("UIListLayout", RightCol).Padding = UDim.new(0, 10)
        
        local isLeft = true

        Window.Tabs[name] = {Btn = TabBtn, Content = TabContent}

        TabBtn.MouseButton1Click:Connect(function()
            for tName, data in pairs(Window.Tabs) do
                if tName == name then
                    data.Content.Visible = true
                    Tween(data.Btn, {BackgroundTransparency = 0.8, TextColor3 = Library.Theme.Text})
                else
                    data.Content.Visible = false
                    Tween(data.Btn, {BackgroundTransparency = 1, TextColor3 = Library.Theme.SubText})
                end
            end
        end)

        if not Window.CurrentTab then
            Window.CurrentTab = name
            TabContent.Visible = true
            TabBtn.BackgroundTransparency = 0.8
            TabBtn.TextColor3 = Library.Theme.Text
        end

        -- [ SECTIONS SYSTEM ]
        function Tab:CreateSection(sectionName)
            local Section = {}
            
            local TargetCol = isLeft and LeftCol or RightCol
            isLeft = not isLeft -- Alternate columns

            local SecFrame = Instance.new("Frame", TargetCol)
            SecFrame.Size = UDim2.new(1, 0, 0, 40) -- Auto adjusts
            SecFrame.BackgroundColor3 = Library.Theme.Section
            Instance.new("UICorner", SecFrame).CornerRadius = UDim.new(0, 8)
            Instance.new("UIStroke", SecFrame).Color = Library.Theme.Element
            
            local SecTitle = Instance.new("TextLabel", SecFrame)
            SecTitle.Size = UDim2.new(1, -20, 0, 30)
            SecTitle.Position = UDim2.new(0, 10, 0, 5)
            SecTitle.BackgroundTransparency = 1
            SecTitle.Text = sectionName
            SecTitle.TextColor3 = Library.Theme.SubText
            SecTitle.Font = Enum.Font.GothamMedium
            SecTitle.TextSize = 12
            SecTitle.TextXAlignment = Enum.TextXAlignment.Left

            local ElementContainer = Instance.new("Frame", SecFrame)
            ElementContainer.Size = UDim2.new(1, 0, 1, -35)
            ElementContainer.Position = UDim2.new(0, 0, 0, 35)
            ElementContainer.BackgroundTransparency = 1
            
            local SecLayout = Instance.new("UIListLayout", ElementContainer)
            SecLayout.Padding = UDim.new(0, 2)
            
            SecLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                SecFrame.Size = UDim2.new(1, 0, 0, SecLayout.AbsoluteContentSize.Y + 45)
                TabContent.CanvasSize = UDim2.new(0, 0, 0, math.max(LeftCol.UIListLayout.AbsoluteContentSize.Y, RightCol.UIListLayout.AbsoluteContentSize.Y) + 20)
            end)

            -- [ ELEMENTS ]
            function Section:CreateToggle(tName, default, callback)
                local state = default or false
                local Toggle = Instance.new("TextButton", ElementContainer)
                Toggle.Size = UDim2.new(1, 0, 0, 35)
                Toggle.BackgroundTransparency = 1
                Toggle.Text = ""

                local Label = Instance.new("TextLabel", Toggle)
                Label.Size = UDim2.new(1, -60, 1, 0)
                Label.Position = UDim2.new(0, 15, 0, 0)
                Label.BackgroundTransparency = 1
                Label.Text = tName
                Label.TextColor3 = Library.Theme.SubText
                Label.Font = Enum.Font.Gotham
                Label.TextSize = 13
                Label.TextXAlignment = Enum.TextXAlignment.Left

                -- iOS Switch Style
                local Pill = Instance.new("Frame", Toggle)
                Pill.Size = UDim2.new(0, 34, 0, 18)
                Pill.Position = UDim2.new(1, -49, 0.5, -9)
                Pill.BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Background
                Instance.new("UICorner", Pill).CornerRadius = UDim.new(1, 0)

                local Circle = Instance.new("Frame", Pill)
                Circle.Size = UDim2.new(0, 14, 0, 14)
                Circle.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
                Circle.BackgroundColor3 = Color3.fromRGB(255,255,255)
                Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

                Toggle.MouseButton1Click:Connect(function()
                    state = not state
                    Label.TextColor3 = state and Library.Theme.Text or Library.Theme.SubText
                    Tween(Pill, {BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Background}, 0.2)
                    Tween(Circle, {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}, 0.2)
                    callback(state)
                end)
            end

            function Section:CreateSlider(sName, min, max, default, callback)
                local SliderVal = default
                local Dragging = false
                
                local Slider = Instance.new("Frame", ElementContainer)
                Slider.Size = UDim2.new(1, 0, 0, 50)
                Slider.BackgroundTransparency = 1
                
                local Label = Instance.new("TextLabel", Slider)
                Label.Size = UDim2.new(1, -20, 0, 20)
                Label.Position = UDim2.new(0, 15, 0, 5)
                Label.BackgroundTransparency = 1
                Label.Text = sName
                Label.TextColor3 = Library.Theme.SubText
                Label.Font = Enum.Font.Gotham
                Label.TextSize = 13
                Label.TextXAlignment = Enum.TextXAlignment.Left

                local Track = Instance.new("Frame", Slider)
                Track.Size = UDim2.new(1, -80, 0, 4)
                Track.Position = UDim2.new(0, 15, 0, 32)
                Track.BackgroundColor3 = Library.Theme.Background
                Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

                local Fill = Instance.new("Frame", Track)
                Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
                Fill.BackgroundColor3 = Library.Theme.Text
                Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
                
                local Thumb = Instance.new("Frame", Fill)
                Thumb.Size = UDim2.new(0, 12, 0, 12)
                Thumb.Position = UDim2.new(1, -6, 0.5, -6)
                Thumb.BackgroundColor3 = Color3.fromRGB(255,255,255)
                Instance.new("UICorner", Thumb).CornerRadius = UDim.new(1, 0)

                local ValBox = Instance.new("TextBox", Slider)
                ValBox.Size = UDim2.new(0, 45, 0, 22)
                ValBox.Position = UDim2.new(1, -60, 0, 23)
                ValBox.BackgroundColor3 = Library.Theme.Background
                ValBox.Text = tostring(default)
                ValBox.TextColor3 = Library.Theme.Text
                ValBox.Font = Enum.Font.Gotham
                ValBox.TextSize = 12
                Instance.new("UICorner", ValBox).CornerRadius = UDim.new(0, 4)

                local function UpdateSlider(input)
                    local percent = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    SliderVal = math.floor(min + (max - min) * percent)
                    ValBox.Text = tostring(SliderVal)
                    Tween(Fill, {Size = UDim2.new(percent, 0, 1, 0)}, 0.1)
                    callback(SliderVal)
                end

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Dragging = true; UpdateSlider(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then UpdateSlider(input) end
                end)
                
                ValBox.FocusLost:Connect(function()
                    local num = tonumber(ValBox.Text)
                    if num then
                        SliderVal = math.clamp(num, min, max)
                        ValBox.Text = tostring(SliderVal)
                        Tween(Fill, {Size = UDim2.new((SliderVal - min) / (max - min), 0, 1, 0)}, 0.2)
                        callback(SliderVal)
                    end
                end)
            end

            -- Expandable with Checkboxes, Dropdowns, ColorPickers...
            return Section
        end
        return Tab
    end
    return Window
end

return Library
