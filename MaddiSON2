-- [ UTILITIES ]
local function Tween(instance, properties, duration)
    local tween = TweenService:Create(instance, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), properties)
    tween:Play()
    return tween
end

-- Procedural Natural Shadow (NO ASSET ID)
local function CreateCodeShadow(parent)
    local ShadowFolder = Instance.new("Folder", parent)
    ShadowFolder.Name = "NaturalShadow"
    local layers = 6
    for i = 1, layers do
        local shadow = Instance.new("Frame")
        shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        shadow.BackgroundTransparency = 0.85 + (i * 0.02)
        shadow.BorderSizePixel = 0
        shadow.ZIndex = 0
        shadow.Size = UDim2.new(1, i * 4, 1, i * 4)
        shadow.Position = UDim2.new(0, -(i * 2), 0, -(i * 2))
        local corner = Instance.new("UICorner", shadow)
        corner.CornerRadius = UDim.new(0, 8 + i)
        shadow.Parent = ShadowFolder
    end
end

local function MakeDraggable(topbar, core)
    local dragging, dragInput, dragStart, startPos
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = core.Position
        end
    end)
    topbar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
            local delta = input.Position - dragStart
            Tween(core, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}, 0.05)
        end
    end)
end

-- [ MAIN WINDOW ]
function Library:CreateWindow(options)
    local titleText = options.Name or "Test UI"
    local Window = {Tabs = {}, CurrentTab = nil}

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MaddiSON_Pro"
    ScreenGui.ResetOnSpawn = false
