        })
    else
        MinimizeButton.Text = "—"
        Tween(Window, 0.3, {
            Size = normalSize
        })
    end
end)

local dragging = false
local dragStart
local startPosition

local function BeginDrag(input)
    dragging = true
    dragStart = input.Position
    startPosition = Window.Position
end

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        BeginDrag(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        Window.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local menuVisible = true
local menuKey = Enum.KeyCode.RightShift

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.KeyCode == menuKey then
        menuVisible = not menuVisible

        if menuVisible then
            Window.Visible = true
            Tween(Window, 0.35, {
                Size = isMinimized and UDim2.fromOffset(700, 68) or normalSize,
                BackgroundTransparency = 0
            }, Enum.EasingStyle.Back)

            Tween(Blur, 0.35, {
                Size = 5
            })
        else
            Tween(Window, 0.3, {
                Size = UDim2.fromOffset(700, 0),
                BackgroundTransparency = 1
            })

            Tween(Blur, 0.3, {
                Size = 0
            })

            task.delay(0.35, function()
                if not menuVisible and Window then
                    Window.Visible = false
                end
            end)
        end
    end
end)

local drift = 0

RunService.RenderStepped:Connect(function(deltaTime)
    drift += deltaTime

    local offset = math.sin(drift * 0.25) * 3

    Grid.Position = UDim2.fromOffset(
        offset,
        math.cos(drift * 0.18) * 2
    )
end)

task.wait()

Tween(Window, 0.65, {
    Position = UDim2.fromScale(0.5, 0.5)
}, Enum.EasingStyle.Back)

Notify("Welcome", "MaddiSON is ready.", "success")
