    self.VersionBadge = Create("TextLabel", {
        Name = "Version",
        Parent = self.TopBar,
        Size = UDim2.new(0, 50, 0, 18),
        Position = UDim2.new(0, 140, 0, 16),
        BackgroundColor3 = GetTheme().Accent,
