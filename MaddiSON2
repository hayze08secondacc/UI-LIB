            BackgroundColor3 = enabled and Theme.Black or Theme.Muted
        })

        if callback then
            callback(enabled)
        end
    end)

    return row
end

local function CreateSlider(parent, title, description, minimum, maximum, default, callback)
    local row = CreateRow(parent, title, description)
    local value = math.clamp(default or minimum, minimum, maximum)

    local track = New("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -13, 0.5, 4),
        Size = UDim2.fromOffset(135, 5),
        BackgroundColor3 = Theme.Hover,
        BorderSizePixel = 0,
        ZIndex = 20
    }, row)

    Corner(track, 5)

    local progress = New("Frame", {
        Size = UDim2.fromScale((value - minimum) / (maximum - minimum), 1),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
        ZIndex = 21
    }, track)

    Corner(progress, 5)

    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((value - minimum) / (maximum - minimum), 0, 0.5, 0),
        Size = UDim2.fromOffset(13, 13),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
        ZIndex = 22
    }, track)

    Corner(knob, 13)

    local valueLabel = New("TextLabel", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, 0, 0, -7),
        Size = UDim2.fromOffset(135, 13),
        BackgroundTransparency = 1,
        Text = tostring(value),
        Font = Enum.Font.GothamBold,
        TextSize = 8,
        TextColor3 = Theme.TextSoft,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 23
    }, row)

    local dragging = false

    local function update(inputX)
        local percentage = math.clamp(
            (inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X,
            0,
            1
        )

        value = math.floor(minimum + ((maximum - minimum) * percentage))

        progress.Size = UDim2.fromScale(percentage, 1)
        knob.Position = UDim2.new(percentage, 0, 0.5, 0)
        valueLabel.Text = tostring(value)

        if callback then
            callback(value)
        end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            update(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return row
end

local function CreateDropdown(parent, title, description, options, default, callback)
    local row = CreateRow(parent, title, description)
    local selected = default or options[1]
    local opened = false

    local dropdown = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(140, 28),
        BackgroundColor3 = Theme.Hover,
        BorderSizePixel = 0,
        Text = selected .. "   ▾",
        Font = Enum.Font.GothamSemibold,
        TextSize = 9,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Center,
        AutoButtonColor = false,
        ZIndex = 25
    }, row)

    Corner(dropdown, 7)
    AddStroke(dropdown, Theme.Border, 1, 0.15)

    local optionsFrame = New("Frame", {
        Position = UDim2.new(0, 0, 1, 5),
        Size = UDim2.new(1, 0, 0, #options * 27),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 60
    }, dropdown)

    Corner(optionsFrame, 7)
    AddStroke(optionsFrame, Theme.Border, 1, 0.1)

    New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder
    }, optionsFrame)

    for _, option in ipairs(options) do
        local optionButton = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 27),
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,
            Text = option,
            Font = Enum.Font.Gotham,
            TextSize = 9,
            TextColor3 = Theme.TextSoft,
            AutoButtonColor = false,
            ZIndex = 61
        }, optionsFrame)

        optionButton.MouseEnter:Connect(function()
            Tween(optionButton, 0.12, {
                BackgroundColor3 = Theme.Hover,
                TextColor3 = Theme.Text
            })
        end)

        optionButton.MouseLeave:Connect(function()
            Tween(optionButton, 0.12, {
                BackgroundColor3 = Theme.Surface,
                TextColor3 = Theme.TextSoft
            })
        end)

        optionButton.MouseButton1Click:Connect(function()
            selected = option
            dropdown.Text = selected .. "   ▾"
            opened = false
            optionsFrame.Visible = false

            if callback then
                callback(selected)
            end
        end)
    end

    dropdown.MouseButton1Click:Connect(function()
        opened = not opened
        optionsFrame.Visible = opened
    end)

    return row
end

local function CreateKeybind(parent, title, description, defaultKey, callback)
    local row = CreateRow(parent, title, description)
    local key = defaultKey or Enum.KeyCode.RightShift
    local listening = false

    local button = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(94, 28),
        BackgroundColor3 = Theme.Hover,
        BorderSizePixel = 0,
        Text = key.Name,
        Font = Enum.Font.GothamBold,
        TextSize = 9,
        TextColor3 = Theme.Text,
        AutoButtonColor = false,
        ZIndex = 20
    }, row)

    Corner(button, 7)
    AddStroke(button, Theme.Border, 1, 0.15)

    button.MouseButton1Click:Connect(function()
        listening = true
        button.Text = "PRESS KEY"

        Tween(button, 0.16, {
            BackgroundColor3 = Theme.White,
            TextColor3 = Theme.Black
        })
    end)

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            key = input.KeyCode
            listening = false
            button.Text = key.Name

            Tween(button, 0.16, {
                BackgroundColor3 = Theme.Hover,
                TextColor3 = Theme.Text
            })
        elseif input.KeyCode == key and not listening then
            if callback then
                callback()
            end
        end
    end)

    return row
end

local function CreateTextbox(parent, title, description, placeholder, callback)
    local row = CreateRow(parent, title, description)

    local box = New("TextBox", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(145, 28),
        BackgroundColor3 = Theme.Hover,
        BorderSizePixel = 0,
        Text = "",
        PlaceholderText = placeholder or "Type here...",
        PlaceholderColor3 = Theme.Muted,
        Font = Enum.Font.Gotham,
        TextSize = 9,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ZIndex = 20
    }, row)

    Corner(box, 7)
    AddStroke(box, Theme.Border, 1, 0.15)
    AddPadding(box, 0, 0, 9, 9)

    box.Focused:Connect(function()
        Tween(box, 0.15, {
            BackgroundColor3 = Theme.Pressed
        })
    end)

    box.FocusLost:Connect(function()
        Tween(box, 0.15, {
            BackgroundColor3 = Theme.Hover
        })

        if callback then
            callback(box.Text)
        end
    end)

    return row
end

