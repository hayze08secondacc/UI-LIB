        Size = UDim2.new(0, 200, 1, -50),
        Position = UDim2.new(0, 0, 0, 50),
        BackgroundColor3 = GetTheme().BackgroundSecondary,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ZIndex = 10,
    })

    self.SidebarContent = Create("ScrollingFrame", {
        Name = "Content",
        Parent = self.Sidebar,
        Size = UDim2.new(1, -1, 1, -10),
        Position = UDim2.new(0, 0, 0, 5),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = GetTheme().Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 11,
    })

    self.SidebarLayout = Create("UIListLayout", {
        Parent = self.SidebarContent,
        Padding = UDim.new(0, 4),
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
    })

    self.ContentArea = Create("Frame", {
        Name = "ContentArea",
        Parent = self.MainFrame,
        Size = UDim2.new(1, -200, 1, -50),
