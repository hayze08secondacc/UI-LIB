function NotificationSystem:Notify(options)
    options = options or {}
    local title = options.Title or "Notification"
    local message = options.Message or ""
    local notifyType = options.Type or "Info"
    local duration = options.Duration or 4
    local theme = GetTheme()

    local typeColors = {
        Success = theme.Success,
        Warning = theme.Warning,
        Error = theme.Error,
        Info = theme.Info,
    }
    local color = typeColors[notifyType] or theme.Info

    local notif = Create("Frame", {
        Name = "Notification",
        Parent = self.Container,
        Size = UDim2.new(0, 320, 0, 0),
        BackgroundColor3 = theme.BackgroundSecondary,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 101,
    })

    local glowLeft = Create("Frame", {
        Name = "GlowLeft",
        Parent = notif,
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = color,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ZIndex = 102,
    })

    local content = Create("Frame", {
        Name = "Content",
        Parent = notif,
        Size = UDim2.new(1, -20, 1, -20),
        Position = UDim2.new(0, 15, 0, 10),
        BackgroundTransparency = 1,
        ZIndex = 103,
    })

    Create("TextLabel", {
        Name = "Icon",
        Parent = content,
        Size = UDim2.new(0, 24, 0, 24),
        BackgroundTransparency = 1,
        Text = notifyType == "Success" and "✓" or notifyType == "Warning" and "⚠" or notifyType == "Error" and "✕" or "ℹ",
        TextColor3 = color,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        ZIndex = 103,
    })

    Create("TextLabel", {
        Name = "Title",
        Parent = content,
        Size = UDim2.new(1, -34, 0, 22),
        Position = UDim2.new(0, 34, 0, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = theme.TextPrimary,
        TextSize = 15,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 103,
    })

    Create("TextLabel", {
        Name = "Message",
        Parent = content,
        Size = UDim2.new(1, -34, 0, 40),
        Position = UDim2.new(0, 34, 0, 24),
        BackgroundTransparency = 1,
        Text = message,
        TextColor3 = theme.TextSecondary,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        ZIndex = 103,
    })

    local progressBg = Create("Frame", {
        Name = "ProgressBg",
        Parent = notif,
        Size = UDim2.new(1, -6, 0, 2),
        Position = UDim2.new(0, 3, 1, -4),
        BackgroundColor3 = theme.Border,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        ZIndex = 102,
    })

    local progressBar = Create("Frame", {
        Name = "ProgressBar",
        Parent = progressBg,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = color,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        ZIndex = 103,
    })

    local textHeight = TextService:GetTextSize(message, 13, Enum.Font.Gotham, Vector2.new(270, 300)).Y
    local targetHeight = math.max(70, textHeight + 45)

    notif.Size = UDim2.new(0, 320, 0, targetHeight)
    FastTween(notif, {BackgroundTransparency = 0.1}, 0.3)
    FastTween(progressBar, {Size = UDim2.new(0, 0, 1, 0)}, duration)

    task.delay(duration, function()
        if notif and notif.Parent then
            FastTween(notif, {BackgroundTransparency = 1}, 0.3)
            task.wait(0.3)
            notif:Destroy()
        end
    end)
end

