local function Notify(title, message, kind)
    local accent = Theme.White

    if kind == "success" then
        accent = Theme.Success
    elseif kind == "error" then
        accent = Theme.Danger
    end

    local notification = New("Frame", {
        Size = UDim2.fromOffset(290, 70),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
        ZIndex = 101
    }, NotificationHolder)

    Corner(notification, 10)
    Stroke(notification, Theme.Border, 1, 0.1)

    local bar = New("Frame", {
        Position = UDim2.fromOffset(0, 12),
        Size = UDim2.fromOffset(3, 46),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        ZIndex = 102
    }, notification)

    Corner(bar, 3)

    New("TextLabel", {
        Position = UDim2.fromOffset(17, 12),
        Size = UDim2.new(1, -30, 0, 17),
        BackgroundTransparency = 1,
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 102
    }, notification)

    New("TextLabel", {
        Position = UDim2.fromOffset(17, 33),
        Size = UDim2.new(1, -30, 0, 24),
        BackgroundTransparency = 1,
        Text = message,
        Font = Enum.Font.Gotham,
        TextSize = 9,
        TextColor3 = Theme.SoftText,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 102
    }, notification)

    task.delay(3, function()
        Tween(notification, 0.3, {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(320, 0)
        })

        task.wait(0.35)

        if notification then
            notification:Destroy()
        end
    end)
end

