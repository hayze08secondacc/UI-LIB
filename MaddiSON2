    self.Pages = Create("Frame", {
        Name = "Pages",
        Parent = self.ContentArea,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 10,
    })

    NotificationSystem:Init(self.ScreenGui)

    -- Window Dragging Functionality
    local dragging, dragStart, startPos
    Connect(self.TopBar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.MainFrame.Position
        end
    end)

    Connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            self.MainFrame.Position = newPos
            for i = 1, 4 do
                self["Shadow" .. i].Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X - i * 4, startPos.Y.Scale, startPos.Y.Offset + delta.Y - i * 4)
            end
        end
    end)

    Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Window Controls logic
    Connect(self.MinimizeBtn.MouseButton1Click, function()
        self.Minimized = not self.Minimized
        FastTween(self.MainFrame, {Size = self.Minimized and UDim2.new(0, 850, 0, 50) or UDim2.new(0, 850, 0, 560)}, 0.3)
    end)

    Connect(self.CloseBtn.MouseButton1Click, function()
        self.ScreenGui:Destroy()
    end)

    -- Realtime Search Filter
    Connect(self.SearchBox:GetPropertyChangedSignal("Text"), function()
        local query = string.lower(self.SearchBox.Text)
        for _, elem in ipairs(self.Elements) do
            if elem.Frame then
                if query == "" or string.find(string.lower(elem.Name), query) then
                    elem.Frame.Visible = true
                else
                    elem.Frame.Visible = false
                end
            end
        end
    end)
end

