    elseif RunService:IsStudio() then ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    else ScreenGui.Parent = CoreGui end

    -- Shadow
    local Shadow = Instance.new("ImageLabel")
    Shadow.Name = "Shadow"
    Shadow.BackgroundTransparency = 1
    Shadow.Position = UDim2.new(0.5, -285, 0.5, -195)
    Shadow.Size = UDim2.new(0, 570, 0, 390)
    Shadow.Image = Library.Theme.Shadow
    Shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    Shadow.ImageTransparency = 0.4
    Shadow.ScaleType = Enum.ScaleType.Slice
    Shadow.SliceCenter = Rect.new(10, 10, 118, 118)
    Shadow.Parent = ScreenGui

    -- Main UI
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Position = UDim2.new(0.5, -275, 0.5, -175)
    Main.Size = UDim2.new(0, 550, 0, 350)
    Main.BackgroundColor3 = Library.Theme.Main
    Main.BorderSizePixel = 0
    Main.ClipsDescendants = true
    Main.Parent = ScreenGui
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 8)
    
    -- Outline Stroke
    local MainStroke = Instance.new("UIStroke", Main)
    MainStroke.Color = Library.Theme.Accent
    MainStroke.Thickness = 1.5
    MainStroke.Transparency = 0.5
    local StrokeGrad = Instance.new("UIGradient", MainStroke)
    StrokeGrad.Color = Library.Theme.AccentGradient
    StrokeGrad.Rotation = 45

    -- Animate Stroke Gradient
    RunService.RenderStepped:Connect(function(dt)
        StrokeGrad.Rotation = (StrokeGrad.Rotation + dt * 25) % 360
    end)

    -- Topbar
    local Topbar = Instance.new("Frame")
    Topbar.Name = "Topbar"
    Topbar.Size = UDim2.new(1, 0, 0, 40)
    Topbar.BackgroundTransparency = 1
    Topbar.Parent = Main
    MakeDraggable(Topbar, Main)

    local Title = Instance.new("TextLabel")
    Title.Text = "  " .. titleText
    Title.Size = UDim2.new(1, 0, 1, 0)
    Title.BackgroundTransparency = 1
    Title.TextColor3 = Library.Theme.Text
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 16
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Topbar

    -- Sidebar for Tabs
    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Size = UDim2.new(0, 140, 1, -40)
    Sidebar.Position = UDim2.new(0, 0, 0, 40)
    Sidebar.BackgroundColor3 = Library.Theme.Sidebar
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main
    
    local SidebarList = Instance.new("UIListLayout", Sidebar)
    SidebarList.SortOrder = Enum.SortOrder.LayoutOrder
    SidebarList.Padding = UDim.new(0, 5)
    SidebarList.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local SidebarPadding = Instance.new("UIPadding", Sidebar)
    SidebarPadding.PaddingTop = UDim.new(0, 10)

    -- Container for Tab Content
    local Canvas = Instance.new("Frame")
    Canvas.Name = "Canvas"
    Canvas.Size = UDim2.new(1, -140, 1, -40)
    Canvas.Position = UDim2.new(0, 140, 0, 40)
    Canvas.BackgroundTransparency = 1
    Canvas.Parent = Main

    -- [ TABS SYSTEM ] --
    function Window:CreateTab(tabName)
        local Tab = {}
        
        -- Tab Button in Sidebar
        local TabBtn = Instance.new("TextButton")
        TabBtn.Size = UDim2.new(0.9, 0, 0, 32)
        TabBtn.BackgroundColor3 = Library.Theme.Main
        TabBtn.Text = tabName
        TabBtn.TextColor3 = Library.Theme.SubText
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 14
        TabBtn.AutoButtonColor = false
        TabBtn.Parent = Sidebar
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        -- Tab Content Area (CanvasGroup for smooth fades)
        local TabContent = Instance.new("ScrollingFrame")
        TabContent.Size = UDim2.new(1, 0, 1, 0)
        TabContent.BackgroundTransparency = 1
        TabContent.ScrollBarThickness = 2
        TabContent.ScrollBarImageColor3 = Library.Theme.Accent
        TabContent.Visible = false
        TabContent.Parent = Canvas
        
        local ContentList = Instance.new("UIListLayout", TabContent)
        ContentList.SortOrder = Enum.SortOrder.LayoutOrder
        ContentList.Padding = UDim.new(0, 8)
        
        local ContentPadding = Instance.new("UIPadding", TabContent)
        ContentPadding.PaddingLeft = UDim.new(0, 15)
        ContentPadding.PaddingRight = UDim.new(0, 15)
        ContentPadding.PaddingTop = UDim.new(0, 10)
        ContentPadding.PaddingBottom = UDim.new(0, 10)

        Window.Tabs[tabName] = {Btn = TabBtn, Content = TabContent}

        -- Logic for Switching Tabs
        TabBtn.MouseButton1Click:Connect(function()
            if Window.CurrentTab == tabName then return end
            
            for name, data in pairs(Window.Tabs) do
                if name == tabName then
                    data.Content.Visible = true
                    CreateTween(data.Btn, "BackgroundColor3", Library.Theme.Element, 0.3)
                    CreateTween(data.Btn, "TextColor3", Library.Theme.Accent, 0.3)
                else
                    data.Content.Visible = false
                    CreateTween(data.Btn, "BackgroundColor3", Library.Theme.Main, 0.3)
                    CreateTween(data.Btn, "TextColor3", Library.Theme.SubText, 0.3)
                end
            end
            Window.CurrentTab = tabName
        end)

        -- Select First Tab Automatically
        if not Window.CurrentTab then
            Window.CurrentTab = tabName
            TabContent.Visible = true
            TabBtn.BackgroundColor3 = Library.Theme.Element
            TabBtn.TextColor3 = Library.Theme.Accent
        end

        -- [ ELEMENTS SYSTEM ] --
        function Tab:CreateButton(name, callback)
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 36)
            Btn.BackgroundColor3 = Library.Theme.Element
            Btn.Text = name
            Btn.TextColor3 = Library.Theme.Text
            Btn.Font = Enum.Font.GothamMedium
            Btn.TextSize = 14
            Btn.ClipsDescendants = true
            Btn.AutoButtonColor = false
            Btn.Parent = TabContent
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

            local Stroke = Instance.new("UIStroke", Btn)
            Stroke.Color = Library.Theme.Accent
            Stroke.Transparency = 1
            Stroke.Thickness = 1

            Btn.MouseEnter:Connect(function()
                CreateTween(Btn, "BackgroundColor3", Library.Theme.Hover, 0.2)
                CreateTween(Stroke, "Transparency", 0.3, 0.2)
            end)
            Btn.MouseLeave:Connect(function()
                CreateTween(Btn, "BackgroundColor3", Library.Theme.Element, 0.2)
                CreateTween(Stroke, "Transparency", 1, 0.2)
            end)

            Btn.MouseButton1Click:Connect(function()
                task.spawn(CreateRipple, Btn)
                CreateTween(Btn, "Size", UDim2.new(0.97, 0, 0, 34), 0.1).Completed:Connect(function()
                    CreateTween(Btn, "Size", UDim2.new(1, 0, 0, 36), 0.1)
                end)
                callback()
            end)
        end

        function Tab:CreateToggle(name, callback)
            local state = false
            local ToggleFrame = Instance.new("TextButton")
            ToggleFrame.Size = UDim2.new(1, 0, 0, 36)
            ToggleFrame.BackgroundColor3 = Library.Theme.Element
            ToggleFrame.Text = ""
            ToggleFrame.AutoButtonColor = false
            ToggleFrame.Parent = TabContent
            Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 6)

            local Label = Instance.new("TextLabel", ToggleFrame)
            Label.Size = UDim2.new(1, -60, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = name
            Label.TextColor3 = Library.Theme.Text
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local Switch = Instance.new("Frame", ToggleFrame)
            Switch.Size = UDim2.new(0, 36, 0, 18)
            Switch.Position = UDim2.new(1, -46, 0.5, -9)
            Switch.BackgroundColor3 = Library.Theme.Main
            Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)
            local SwitchStroke = Instance.new("UIStroke", Switch)
            SwitchStroke.Color = Library.Theme.SubText
            SwitchStroke.Thickness = 1

            local Circle = Instance.new("Frame", Switch)
            Circle.Size = UDim2.new(0, 14, 0, 14)
            Circle.Position = UDim2.new(0, 2, 0.5, -7)
            Circle.BackgroundColor3 = Library.Theme.SubText
            Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

            ToggleFrame.MouseButton1Click:Connect(function()
                state = not state
                task.spawn(CreateRipple, ToggleFrame)
                if state then
                    CreateTween(Circle, "Position", UDim2.new(1, -16, 0.5, -7), 0.25)
                    CreateTween(Circle, "BackgroundColor3", Library.Theme.Accent, 0.25)
                    CreateTween(SwitchStroke, "Color", Library.Theme.Accent, 0.25)
                else
                    CreateTween(Circle, "Position", UDim2.new(0, 2, 0.5, -7), 0.25)
                    CreateTween(Circle, "BackgroundColor3", Library.Theme.SubText, 0.25)
                    CreateTween(SwitchStroke, "Color", Library.Theme.SubText, 0.25)
                end
                callback(state)
            end)
        end

        function Tab:CreateKeybind(name, defaultKey, callback)
            local currentKey = defaultKey
            local listening = false
            
            local BindFrame = Instance.new("Frame")
            BindFrame.Size = UDim2.new(1, 0, 0, 36)
            BindFrame.BackgroundColor3 = Library.Theme.Element
            BindFrame.Parent = TabContent
            Instance.new("UICorner", BindFrame).CornerRadius = UDim.new(0, 6)

            local Label = Instance.new("TextLabel", BindFrame)
            Label.Size = UDim2.new(1, -100, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = name
            Label.TextColor3 = Library.Theme.Text
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local KeyBtn = Instance.new("TextButton", BindFrame)
            KeyBtn.Size = UDim2.new(0, 70, 0, 24)
            KeyBtn.Position = UDim2.new(1, -80, 0.5, -12)
            KeyBtn.BackgroundColor3 = Library.Theme.Main
            KeyBtn.Text = currentKey.Name
            KeyBtn.TextColor3 = Library.Theme.Accent
            KeyBtn.Font = Enum.Font.GothamBold
            KeyBtn.TextSize = 12
            Instance.new("UICorner", KeyBtn).CornerRadius = UDim.new(0, 4)
            Instance.new("UIStroke", KeyBtn).Color = Library.Theme.Accent

            KeyBtn.MouseButton1Click:Connect(function()
                listening = true
                KeyBtn.Text = "..."
                CreateTween(KeyBtn, "BackgroundColor3", Library.Theme.Hover, 0.2)
            end)

            UserInputService.InputBegan:Connect(function(input)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = input.KeyCode
                    KeyBtn.Text = currentKey.Name
                    listening = false
                    CreateTween(KeyBtn, "BackgroundColor3", Library.Theme.Main, 0.2)
                elseif not listening and input.KeyCode == currentKey then
                    callback()
                end
            end)
        end
        
        return Tab
    end
    
    return Window
end

return Library
