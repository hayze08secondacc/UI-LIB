local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

local Library = {
    Theme = {
        Background = Color3.fromRGB(13, 13, 16),
        Sidebar = Color3.fromRGB(18, 18, 22),
        Section = Color3.fromRGB(22, 22, 27),
        Element = Color3.fromRGB(28, 28, 35),
        Hover = Color3.fromRGB(38, 38, 48),
        Accent = Color3.fromRGB(120, 80, 255),
        Text = Color3.fromRGB(240, 240, 245),
        SubText = Color3.fromRGB(140, 140, 155),
        Outline = Color3.fromRGB(45, 45, 58)
    }
}

-- [ UTILITY ENGINE ]
local function Tween(instance, properties, duration, style, direction)
    local info = TweenInfo.new(duration or 0.25, style or Enum.EasingStyle.Exponential, direction or Enum.EasingDirection.Out)
    local tween = TweenService:Create(instance, info, properties)
    tween:Play()
    return tween
end

local function ApplyProceduralShadow(parent, intensity)
    local folder = Instance.new("Folder", parent)
    folder.Name = "ShadowContainer"
    local count = intensity or 6
    for i = 1, count do
        local shadow = Instance.new("Frame", folder)
        shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        shadow.BackgroundTransparency = 0.82 + (i * 0.02)
        shadow.BorderSizePixel = 0
        shadow.ZIndex = parent.ZIndex - 1
        shadow.Size = UDim2.new(1, i * 5, 1, i * 5)
        shadow.Position = UDim2.new(0, -(i * 2.5), 0, -(i * 2.5))
        local corner = Instance.new("UICorner", shadow)
        corner.CornerRadius = UDim.new(0, 10 + i)
    end
end

local function MakeDraggable(topbar, core)
    local dragging, dragInput, dragStart, startPos
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = core.Position
        end
    end)
    topbar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Tween(core, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}, 0.1)
        end
    end)
end

-- [ NOTIFICATION SYSTEM ]
function Library:Notify(title, desc, duration)
    task.spawn(function()
        local gui = CoreGui:FindFirstChild("MaddiSON_Notifications")
        if not gui then
            gui = Instance.new("ScreenGui", CoreGui)
            gui.Name = "MaddiSON_Notifications"
            gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
            local layout = Instance.new("UIListLayout", gui)
            layout.SortOrder = Enum.SortOrder.LayoutOrder
            layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
            layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
            layout.Padding = UDim.new(0, 10)
            local pad = Instance.new("UIPadding", gui)
            pad.PaddingRight = UDim.new(0, 20)
            pad.PaddingBottom = UDim.new(0, 20)
        end

        local card = Instance.new("Frame", gui)
        card.Size = UDim2.new(0, 280, 0, 70)
        card.BackgroundColor3 = Library.Theme.Sidebar
        card.BorderSizePixel = 0
        card.Position = UDim2.new(1, 300, 0, 0)
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
        Instance.new("UIStroke", card).Color = Library.Theme.Accent

        local tLbl = Instance.new("TextLabel", card)
        tLbl.Size = UDim2.new(1, -20, 0, 25)
        tLbl.Position = UDim2.new(0, 10, 0, 5)
        tLbl.BackgroundTransparency = 1
        tLbl.Text = title
        tLbl.TextColor3 = Library.Theme.Text
        tLbl.Font = Enum.Font.GothamBold
        tLbl.TextSize = 14
        tLbl.TextXAlignment = Enum.TextXAlignment.Left

        local dLbl = Instance.new("TextLabel", card)
        dLbl.Size = UDim2.new(1, -20, 0, 35)
        dLbl.Position = UDim2.new(0, 10, 0, 25)
        dLbl.BackgroundTransparency = 1
        dLbl.Text = desc
        dLbl.TextColor3 = Library.Theme.SubText
        dLbl.Font = Enum.Font.Gotham
        dLbl.TextSize = 12
        dLbl.TextXAlignment = Enum.TextXAlignment.Left
        dLbl.TextWrapped = true

        Tween(card, {Position = UDim2.new(0, 0, 0, 0)}, 0.4)
        task.wait(duration or 3)
        Tween(card, {Position = UDim2.new(1, 300, 0, 0)}, 0.4)
        task.wait(0.4)
        card:Destroy()
    end)
end

-- [ WINDOW CREATION ]
function Library:CreateWindow(titleText)
    local Window = {Tabs = {}, CurrentTab = nil}

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MaddiSON_Enterprise"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    if gethui then ScreenGui.Parent = gethui() else ScreenGui.Parent = CoreGui end

    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.new(0, 760, 0, 480)
    Main.Position = UDim2.new(0.5, -380, 0.5, -240)
    Main.BackgroundColor3 = Library.Theme.Background
    Main.BorderSizePixel = 0
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 10)
    ApplyProceduralShadow(Main, 8)

    local Sidebar = Instance.new("Frame", Main)
    Sidebar.Size = UDim2.new(0, 200, 1, 0)
    Sidebar.BackgroundColor3 = Library.Theme.Sidebar
    Sidebar.BorderSizePixel = 0
    Instance.new("UICorner", Sidebar).CornerRadius = UDim.new(0, 10)

    -- Fix Sidebar Sharp Edge
    local Cover = Instance.new("Frame", Sidebar)
    Cover.Size = UDim2.new(0, 10, 1, 0)
    Cover.Position = UDim2.new(1, -10, 0, 0)
    Cover.BackgroundColor3 = Library.Theme.Sidebar
    Cover.BorderSizePixel = 0

    local TopTitle = Instance.new("TextLabel", Sidebar)
    TopTitle.Size = UDim2.new(1, 0, 0, 60)
    TopTitle.BackgroundTransparency = 1
    TopTitle.Text = "  " .. titleText
    TopTitle.TextColor3 = Library.Theme.Text
    TopTitle.Font = Enum.Font.GothamBold
    TopTitle.TextSize = 16
    TopTitle.TextXAlignment = Enum.TextXAlignment.Left
    MakeDraggable(TopTitle, Main)

    local TabScroll = Instance.new("ScrollingFrame", Sidebar)
    TabScroll.Size = UDim2.new(1, 0, 1, -70)
    TabScroll.Position = UDim2.new(0, 0, 0, 65)
    TabScroll.BackgroundTransparency = 1
    TabScroll.ScrollBarThickness = 0
    local TabListLayout = Instance.new("UIListLayout", TabScroll)
    TabListLayout.Padding = UDim.new(0, 4)
    TabListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local ContentContainer = Instance.new("Frame", Main)
    ContentContainer.Size = UDim2.new(1, -210, 1, -10)
    ContentContainer.Position = UDim2.new(0, 205, 0, 5)
    ContentContainer.BackgroundTransparency = 1

    function Window:CreateTab(tabName)
        local Tab = {}

        local TabBtn = Instance.new("TextButton", TabScroll)
        TabBtn.Size = UDim2.new(1, -20, 0, 36)
        TabBtn.BackgroundColor3 = Library.Theme.Background
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text = "   " .. tabName
        TabBtn.TextColor3 = Library.Theme.SubText
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 14
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        local CanvasGroup = Instance.new("CanvasGroup", ContentContainer)
        CanvasGroup.Size = UDim2.new(1, 0, 1, 0)
        CanvasGroup.BackgroundTransparency = 1
        CanvasGroup.GroupTransparency = 1
        CanvasGroup.Visible = false

        local LeftCol = Instance.new("ScrollingFrame", CanvasGroup)
        LeftCol.Size = UDim2.new(0.5, -5, 1, 0)
        LeftCol.BackgroundTransparency = 1
        LeftCol.ScrollBarThickness = 2
        LeftCol.ScrollBarImageColor3 = Library.Theme.Accent
        local LLayout = Instance.new("UIListLayout", LeftCol)
        LLayout.Padding = UDim.new(0, 10)

        local RightCol = Instance.new("ScrollingFrame", CanvasGroup)
        RightCol.Size = UDim2.new(0.5, -5, 1, 0)
        RightCol.Position = UDim2.new(0.5, 5, 0, 0)
        RightCol.BackgroundTransparency = 1
        RightCol.ScrollBarThickness = 2
        RightCol.ScrollBarImageColor3 = Library.Theme.Accent
        local RLayout = Instance.new("UIListLayout", RightCol)
        RLayout.Padding = UDim.new(0, 10)

        Window.Tabs[tabName] = {Btn = TabBtn, Content = CanvasGroup}

        TabBtn.MouseButton1Click:Connect(function()
            if Window.CurrentTab == tabName then return end
            for name, data in pairs(Window.Tabs) do
                if name == tabName then
                    data.Content.Visible = true
                    Tween(data.Content, {GroupTransparency = 0}, 0.3)
                    Tween(data.Btn, {BackgroundTransparency = 0.5, TextColor3 = Library.Theme.Text}, 0.2)
                else
                    Tween(data.Content, {GroupTransparency = 1}, 0.2).Completed:Connect(function()
                        if Window.CurrentTab ~= name then data.Content.Visible = false end
                    end)
                    Tween(data.Btn, {BackgroundTransparency = 1, TextColor3 = Library.Theme.SubText}, 0.2)
                end
            end
            Window.CurrentTab = tabName
        end)

        if not Window.CurrentTab then
            Window.CurrentTab = tabName
            CanvasGroup.Visible = true
            CanvasGroup.GroupTransparency = 0
            TabBtn.BackgroundTransparency = 0.5
            TabBtn.TextColor3 = Library.Theme.Text
        end

        function Tab:CreateSection(secName, side)
            local Section = {}
            local targetColumn = (side == "Right") and RightCol or LeftCol

            local SecFrame = Instance.new("Frame", targetColumn)
            SecFrame.Size = UDim2.new(1, 0, 0, 40)
            SecFrame.BackgroundColor3 = Library.Theme.Section
            Instance.new("UICorner", SecFrame).CornerRadius = UDim.new(0, 8)
            Instance.new("UIStroke", SecFrame).Color = Library.Theme.Outline

            local Title = Instance.new("TextLabel", SecFrame)
            Title.Size = UDim2.new(1, -20, 0, 30)
            Title.Position = UDim2.new(0, 12, 0, 5)
            Title.BackgroundTransparency = 1
            Title.Text = secName
            Title.TextColor3 = Library.Theme.SubText
            Title.Font = Enum.Font.GothamBold
            Title.TextSize = 12
            Title.TextXAlignment = Enum.TextXAlignment.Left

            local Container = Instance.new("Frame", SecFrame)
            Container.Size = UDim2.new(1, 0, 1, -35)
            Container.Position = UDim2.new(0, 0, 0, 35)
            Container.BackgroundTransparency = 1
            local SLayout = Instance.new("UIListLayout", Container)
            SLayout.Padding = UDim.new(0, 4)
            SLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

            SLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                SecFrame.Size = UDim2.new(1, 0, 0, SLayout.AbsoluteContentSize.Y + 45)
                LeftCol.CanvasSize = UDim2.new(0, 0, 0, LLayout.AbsoluteContentSize.Y + 20)
                RightCol.CanvasSize = UDim2.new(0, 0, 0, RLayout.AbsoluteContentSize.Y + 20)
            end)

            -- [ TOGGLE ]
            function Section:CreateToggle(name, default, callback)
                local state = default or false
                local TBtn = Instance.new("TextButton", Container)
                TBtn.Size = UDim2.new(1, -20, 0, 34)
                TBtn.BackgroundColor3 = Library.Theme.Element
                TBtn.Text = ""
                Instance.new("UICorner", TBtn).CornerRadius = UDim.new(0, 6)

                local Lbl = Instance.new("TextLabel", TBtn)
                Lbl.Size = UDim2.new(1, -55, 1, 0)
                Lbl.Position = UDim2.new(0, 10, 0, 0)
                Lbl.BackgroundTransparency = 1
                Lbl.Text = name
                Lbl.TextColor3 = state and Library.Theme.Text or Library.Theme.SubText
                Lbl.Font = Enum.Font.Gotham
                Lbl.TextSize = 13
                Lbl.TextXAlignment = Enum.TextXAlignment.Left

                local Pill = Instance.new("Frame", TBtn)
                Pill.Size = UDim2.new(0, 36, 0, 18)
                Pill.Position = UDim2.new(1, -44, 0.5, -9)
                Pill.BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Background
                Instance.new("UICorner", Pill).CornerRadius = UDim.new(1, 0)

                local Knob = Instance.new("Frame", Pill)
                Knob.Size = UDim2.new(0, 14, 0, 14)
                Knob.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
                Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

                TBtn.MouseButton1Click:Connect(function()
                    state = not state
                    Lbl.TextColor3 = state and Library.Theme.Text or Library.Theme.SubText
                    Tween(Pill, {BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Background}, 0.2)
                    Tween(Knob, {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}, 0.2)
                    callback(state)
                end)
            end

            -- [ SLIDER ]
            function Section:CreateSlider(name, min, max, default, callback)
                local val = default or min
                local dragging = false

                local SFrame = Instance.new("Frame", Container)
                SFrame.Size = UDim2.new(1, -20, 0, 50)
                SFrame.BackgroundColor3 = Library.Theme.Element
                Instance.new("UICorner", SFrame).CornerRadius = UDim.new(0, 6)

                local Lbl = Instance.new("TextLabel", SFrame)
                Lbl.Size = UDim2.new(1, -60, 0, 20)
                Lbl.Position = UDim2.new(0, 10, 0, 5)
                Lbl.BackgroundTransparency = 1
                Lbl.Text = name
                Lbl.TextColor3 = Library.Theme.Text
                Lbl.Font = Enum.Font.Gotham
                Lbl.TextSize = 13
                Lbl.TextXAlignment = Enum.TextXAlignment.Left

                local ValBox = Instance.new("TextBox", SFrame)
                ValBox.Size = UDim2.new(0, 45, 0, 20)
                ValBox.Position = UDim2.new(1, -55, 0, 5)
                ValBox.BackgroundTransparency = 1
                ValBox.Text = tostring(val)
                ValBox.TextColor3 = Library.Theme.Accent
                ValBox.Font = Enum.Font.GothamBold
                ValBox.TextSize = 12
                ValBox.TextXAlignment = Enum.TextXAlignment.Right

                local Track = Instance.new("Frame", SFrame)
                Track.Size = UDim2.new(1, -20, 0, 4)
                Track.Position = UDim2.new(0, 10, 0, 36)
                Track.BackgroundColor3 = Library.Theme.Background
                Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

                local Fill = Instance.new("Frame", Track)
                Fill.Size = UDim2.new((val - min)/(max - min), 0, 1, 0)
                Fill.BackgroundColor3 = Library.Theme.Accent
                Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

                local function update(input)
                    local percent = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    val = math.floor(min + ((max - min) * percent))
                    ValBox.Text = tostring(val)
                    Tween(Fill, {Size = UDim2.new(percent, 0, 1, 0)}, 0.08)
                    callback(val)
                end

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; update(input) end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
                end)
            end

            -- [ DROPDOWN ]
            function Section:CreateDropdown(name, options, default, callback)
                local selected = default or options[1]
                local open = false

                local DFrame = Instance.new("Frame", Container)
                DFrame.Size = UDim2.new(1, -20, 0, 36)
                DFrame.BackgroundColor3 = Library.Theme.Element
                DFrame.ClipsDescendants = true
                Instance.new("UICorner", DFrame).CornerRadius = UDim.new(0, 6)

                local DBtn = Instance.new("TextButton", DFrame)
                DBtn.Size = UDim2.new(1, 0, 0, 36)
                DBtn.BackgroundTransparency = 1
                DBtn.Text = "  " .. name .. " : " .. selected
                DBtn.TextColor3 = Library.Theme.Text
                DBtn.Font = Enum.Font.Gotham
                DBtn.TextSize = 13
                DBtn.TextXAlignment = Enum.TextXAlignment.Left

                local DList = Instance.new("Frame", DFrame)
                DList.Size = UDim2.new(1, 0, 1, -36)
                DList.Position = UDim2.new(0, 0, 0, 36)
                DList.BackgroundTransparency = 1
                local DLayout = Instance.new("UIListLayout", DList)
                DLayout.Padding = UDim.new(0, 2)

                for _, opt in ipairs(options) do
                    local OBtn = Instance.new("TextButton", DList)
                    OBtn.Size = UDim2.new(1, 0, 0, 30)
                    OBtn.BackgroundColor3 = Library.Theme.Background
                    OBtn.Text = opt
                    OBtn.TextColor3 = Library.Theme.SubText
                    OBtn.Font = Enum.Font.Gotham
                    OBtn.TextSize = 12

                    OBtn.MouseButton1Click:Connect(function()
                        selected = opt
                        DBtn.Text = "  " .. name .. " : " .. selected
                        callback(selected)
                        open = false
                        Tween(DFrame, {Size = UDim2.new(1, -20, 0, 36)}, 0.2)
                    end)
                end

                DBtn.MouseButton1Click:Connect(function()
                    open = not open
                    local targetHeight = open and (36 + (#options * 32)) or 36
                    Tween(DFrame, {Size = UDim2.new(1, -20, 0, targetHeight)}, 0.2)
                end)
            end

            return Section
        end
        return Tab
    end
    return Window
end

return Library
