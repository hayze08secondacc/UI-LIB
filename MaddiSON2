    }, toggle)

    toggle.MouseButton1Click:Connect(function()
        enabled = not enabled

        Tween(toggle, 0.2, {
            BackgroundColor3 = enabled and Theme.AccentDark or Theme.Element
        })

        Tween(toggleStroke, 0.2, {
            Color = enabled and Theme.Accent or Theme.Stroke
        })

        Tween(knob, 0.2, {
            Position = enabled and UDim2.new(1, -13, 0.5, 0) or UDim2.new(0, 13, 0.5, 0),
            BackgroundColor3 = enabled and Theme.Text or Theme.SubText
        })

        if callback then
            callback(enabled)
        end
    end)

    return row
end

local function CreateSlider(parent, title, description, minimum, maximum, default, callback)
    local row = CreateRow(parent, title, description)
    local value = default or minimum

    local slider = New("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -13, 0.5, 0),
        Size = UDim2.fromOffset(150, 5),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        ZIndex = 17
    }, row)

    Stroke(slider, Theme.Stroke, 1, 0.35)

    local fill = New("Frame", {
        Size = UDim2.fromScale((value - minimum) / (maximum - minimum), 1),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 18
    }, slider)

    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((value - minimum) / (maximum - minimum), 0, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 19
    }, slider)

    local valueLabel = New("TextLabel", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, 0, 0, -9),
        Size = UDim2.fromOffset(150, 15),
        BackgroundTransparency = 1,
        Text = tostring(value),
        Font = Enum.Font.GothamBold,
        TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = Theme.Accent,
        ZIndex = 20
    }, row)

    local dragging = false

    local function update(inputX)
        local position = math.clamp(
            (inputX - slider.AbsolutePosition.X) / slider.AbsoluteSize.X,
            0,
            1
        )

        value = math.floor(minimum + ((maximum - minimum) * position))
        fill.Size = UDim2.fromScale(position, 1)
        knob.Position = UDim2.new(position, 0, 0.5, 0)
        valueLabel.Text = tostring(value)

        if callback then
            callback(value)
        end
    end

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return row
end

local function CreateDropdown(parent, title, description, options, default, callback)
    local row = CreateRow(parent, title, description)
    local selected = default or options[1]
    local opened = false

    local dropdown = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -13, 0.5, 0),
        Size = UDim2.fromOffset(145, 30),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Text = selected .. "  ▾",
        Font = Enum.Font.GothamSemibold,
        TextSize = 10,
        TextColor3 = Theme.Text,
        AutoButtonColor = false,
        ZIndex = 20
    }, row)

    Stroke(dropdown, Theme.Stroke, 1, 0.25)

    local optionFrame = New("Frame", {
        Position = UDim2.new(0, 0, 1, 6),
        Size = UDim2.new(1, 0, 0, #options * 29),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 40
    }, dropdown)

    Stroke(optionFrame, Theme.Accent, 1, 0.25)

    New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder
    }, optionFrame)

    for _, option in ipairs(options) do
        local optionButton = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 29),
            BackgroundColor3 = Theme.Panel,
            BorderSizePixel = 0,
            Text = option,
            Font = Enum.Font.Gotham,
            TextSize = 10,
            TextColor3 = Theme.SubText,
            AutoButtonColor = false,
            ZIndex = 41
        }, optionFrame)

        optionButton.MouseEnter:Connect(function()
            Tween(optionButton, 0.12, {
                BackgroundColor3 = Theme.AccentDark,
                TextColor3 = Theme.Text
            })
        end)

        optionButton.MouseLeave:Connect(function()
            Tween(optionButton, 0.12, {
                BackgroundColor3 = Theme.Panel,
                TextColor3 = Theme.SubText
            })
        end)

        optionButton.MouseButton1Click:Connect(function()
            selected = option
            dropdown.Text = selected .. "  ▾"
            opened = false
            optionFrame.Visible = false

            if callback then
                callback(selected)
            end
        end)
    end

    dropdown.MouseButton1Click:Connect(function()
        opened = not opened
        optionFrame.Visible = opened
    end)

    return row
end

local function CreateKeybind(parent, title, description, defaultKey, callback)
    local row = CreateRow(parent, title, description)
    local key = defaultKey or Enum.KeyCode.RightShift
    local listening = false

    local keyButton = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -13, 0.5, 0),
        Size = UDim2.fromOffset(105, 30),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Text = key.Name,
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        TextColor3 = Theme.Accent,
        AutoButtonColor = false,
        ZIndex = 17
    }, row)

    Stroke(keyButton, Theme.Stroke, 1, 0.25)

    keyButton.MouseButton1Click:Connect(function()
        listening = true
        keyButton.Text = "PRESS KEY"
        Tween(keyButton, 0.15, {BackgroundColor3 = Theme.AccentDark})
    end)

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            key = input.KeyCode
            listening = false
            keyButton.Text = key.Name
            Tween(keyButton, 0.15, {BackgroundColor3 = Theme.Element})
        elseif input.KeyCode == key and not listening then
            if callback then
                callback()
            end
        end
    end)

    return row
end

local function CreateTextbox(parent, title, description, placeholder, callback)
    local row = CreateRow(parent, title, description)

    local box = New("TextBox", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -13, 0.5, 0),
        Size = UDim2.fromOffset(160, 30),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Text = "",
        PlaceholderText = placeholder or "Type here...",
        PlaceholderColor3 = Theme.SubText,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextColor3 = Theme.Text,
        ClearTextOnFocus = false,
        ZIndex = 17
    }, row)

    Stroke(box, Theme.Stroke, 1, 0.25)

    box.FocusLost:Connect(function()
        if callback then
            callback(box.Text)
        end
    end)

    return row
end

local function Notify(title, message, color)
    local notification = New("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -25, 1, 80),
        Size = UDim2.fromOffset(300, 78),
        BackgroundColor3 = Theme.PanelLight,
        BorderSizePixel = 0,
        ZIndex = 100
    }, ScreenGui)

    local notificationStroke = Stroke(notification, color or Theme.Accent, 1.4, 0.15)

    New("Frame", {
        Size = UDim2.fromOffset(4, 78),
        BackgroundColor3 = color or Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 101
    }, notification)

    New("TextLabel", {
        Position = UDim2.fromOffset(17, 13),
        Size = UDim2.new(1, -30, 0, 20),
        BackgroundTransparency = 1,
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Theme.Text,
        ZIndex = 101
    }, notification)

    New("TextLabel", {
        Position = UDim2.fromOffset(17, 37),
        Size = UDim2.new(1, -30, 0, 28),
        BackgroundTransparency = 1,
        Text = message,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Theme.SubText,
        ZIndex = 101
    }, notification)

    Tween(notification, 0.4, {
        Position = UDim2.new(1, -25, 1, -25)
    })

    task.delay(3.5, function()
        Tween(notification, 0.35, {
            Position = UDim2.new(1, -25, 1, 80),
            BackgroundTransparency = 1
        })

        Tween(notificationStroke, 0.35, {
            Transparency = 1
        })

        task.wait(0.4)
        notification:Destroy()
    end)
end

