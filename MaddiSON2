local dragging = false
local dragStart
local startPosition

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = Main.Position
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragStart = dragStart or input.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local menuVisible = true

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.KeyCode == Enum.KeyCode.RightShift then
        menuVisible = not menuVisible

        if menuVisible then
            Main.Visible = true
            Tween(Main, 0.35, {
                Size = UDim2.fromOffset(880, 550),
                BackgroundTransparency = 0.06
            })
            Tween(Blur, 0.35, {Size = 8})
        else
            Tween(Main, 0.35, {
                Size = UDim2.fromOffset(880, 0),
                BackgroundTransparency = 1
            })
            Tween(Blur, 0.35, {Size = 0})

            task.delay(0.4, function()
                if not menuVisible then
                    Main.Visible = false
                end
            end)
        end
    end
end)

RunService.RenderStepped:Connect(function(deltaTime)
    for _, data in ipairs(geometricObjects) do
        local object = data.Object
        local stroke = data.Stroke

        object.Rotation += data.Speed * deltaTime
        object.Position += UDim2.fromOffset(
            math.sin(os.clock() * 0.35 + data.Speed) * deltaTime * data.Distance,
            math.cos(os.clock() * 0.3 + data.Speed) * deltaTime * data.Distance
        )

        object.BackgroundColor3 = Theme.Accent
        stroke.Color = Theme.Accent
    end

    local pulse = (math.sin(os.clock() * 1.5) + 1) / 2
    GlowStroke.Transparency = 0.92 - pulse * 0.08
    TopLine.BackgroundColor3 = Theme.Accent
end)

task.wait(0.1)

Tween(Main, 0.7, {
    Position = UDim2.fromScale(0.5, 0.5),
    BackgroundTransparency = 0.06
}, Enum.EasingStyle.Back)

Notify("Welcome", "MaddiSON is ready.", Theme.Accent)
