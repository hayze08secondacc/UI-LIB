local function Create(className, properties)
    local instance = Instance.new(className)
    for prop, value in pairs(properties or {}) do
        if prop == "Parent" then continue end
        instance[prop] = value
    end
    if properties and properties.Parent then
        instance.Parent = properties.Parent
    end
    return instance
end

local function Tween(instance, info, goals)
    local tween = TweenService:Create(instance, info, goals)
    tween:Play()
    return tween
end

local function FastTween(instance, goals, duration)
    return Tween(instance, TweenInfo.new(duration or 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), goals)
end

local function Connect(event, callback)
    local conn = event:Connect(callback)
    table.insert(MaddiSON.Connections, conn)
    return conn
end

local function GetTheme()
    return MaddiSON.Themes[MaddiSON.CurrentTheme] or MaddiSON.Themes.Obsidian
end

