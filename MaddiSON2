    local toggle = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -13, 0.5, 0),
        Size = UDim2.fromOffset(48, 25),
        BackgroundColor3 = enabled and Theme.AccentDark or Theme.Element,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 17
    }, row)

    local toggleStroke = Stroke(toggle, enabled and Theme.Accent or Theme.Stroke, 1, 0.2)

    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = enabled and UDim2.new(1, -13, 0.5, 0) or UDim2.new(0, 13, 0.5, 0),
        Size = UDim2.fromOffset(17, 17),
        BackgroundColor3 = enabled and Theme.Text or Theme.SubText,
        BorderSizePixel = 0,
