-- 🛠️ UTILITIES
local function Create(className, properties)
    local instance = Instance.new(className)
    for k, v in pairs(properties) do
        if k ~= "Parent" then instance[k] = v end
    end
    if properties.Parent then instance.Parent = properties.Parent end
    return instance
end

local function Tween(instance, properties, duration)
    local tweenInfo = TweenService:Create(instance, TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), properties)
    tweenInfo:Play()
    return tweenInfo
end

local function GetTheme()
    return MaddiSON.Themes[MaddiSON.CurrentTheme]
end

-- 💧 MATERIAL RIPPLE EFFECT
local function CreateRipple(parent, x, y)
    task.spawn(function()
        local absolutePos = parent.AbsolutePosition
        local size = parent.AbsoluteSize
        local maxRadius = math.sqrt(size.X^2 + size.Y^2)

        local ripple = Create("Frame", {
            Parent = parent,
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = 0.8,
            BorderSizePixel = 0,
            Position = UDim2.new(0, x - absolutePos.X, 0, y - absolutePos.Y),
            Size = UDim2.new(0, 0, 0, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ZIndex = parent.ZIndex + 1
        })
        Create("UICorner", { Parent = ripple, CornerRadius = UDim.new(1, 0) })

        Tween(ripple, {Size = UDim2.new(0, maxRadius * 2, 0, maxRadius * 2), BackgroundTransparency = 1}, 0.6)
        task.wait(0.6)
        ripple:Destroy()
    end)
end

-- 🖥️ MAIN UI INITIALIZATION
function MaddiSON:Init(title)
    local theme = GetTheme()
    
    local existing = LocalPlayer.PlayerGui:FindFirstChild("MaddiSON_V3")
    if existing then existing:Destroy() end

    self.ScreenGui = Create("ScreenGui", {
        Name = "MaddiSON_V3",
        Parent = LocalPlayer.PlayerGui,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
    })

    -- Shadow
    self.Shadow = Create("ImageLabel", {
        Parent = self.ScreenGui,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 640, 0, 440),
        BackgroundTransparency = 1,
        Image = "rbxassetid://13192866579", -- Soft drop shadow asset
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = 0.4,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(100, 100, 100, 100),
        SliceScale = 1.5,
    })

    self.MainFrame = Create("Frame", {
        Parent = self.Shadow,
        Size = UDim2.new(1, -40, 1, -40),
        Position = UDim2.new(0, 20, 0, 20),
        BackgroundColor3 = theme.Background,
        ClipsDescendants = true,
    })
    Create("UICorner", { Parent = self.MainFrame, CornerRadius = UDim.new(0, 10) })
    Create("UIStroke", { Parent = self.MainFrame, Color = theme.Stroke, Thickness = 1 })

    -- 🌟 AMBIENT ORB BACKGROUND (Glassmorphism feel)
    local orb1 = Create("Frame", {
        Parent = self.MainFrame,
        Size = UDim2.new(0, 300, 0, 300),
        Position = UDim2.new(0, -50, 0, -50),
        BackgroundColor3 = theme.Accent,
        BackgroundTransparency = 0.85,
        ZIndex = 0
    })
    Create("UICorner", { Parent = orb1, CornerRadius = UDim.new(1, 0) })
    
    local orb2 = Create("Frame", {
        Parent = self.MainFrame,
        Size = UDim2.new(0, 400, 0, 400),
        Position = UDim2.new(1, -200, 1, -200),
        BackgroundColor3 = theme.AccentGlow,
        BackgroundTransparency = 0.9,
        ZIndex = 0
    })
    Create("UICorner", { Parent = orb2, CornerRadius = UDim.new(1, 0) })

    -- Orb Animation
    RunService.RenderStepped:Connect(function()
        local t = tick() * 0.5
        orb1.Position = UDim2.new(0, -50 + math.sin(t) * 30, 0, -50 + math.cos(t * 0.8) * 30)
        orb2.Position = UDim2.new(1, -200 + math.cos(t * 1.2) * 40, 1, -200 + math.sin(t * 0.9) * 40)
    end)

    -- Top Navigation Bar
    self.TopBar = Create("Frame", {
        Parent = self.MainFrame,
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundTransparency = 1,
        ZIndex = 10,
    })
    
    local titleLabel = Create("TextLabel", {
        Parent = self.TopBar,
        Size = UDim2.new(1, -30, 1, 0),
        Position = UDim2.new(0, 20, 0, 0),
        BackgroundTransparency = 1,
        Text = title or "MaddiSON 3.0",
        TextColor3 = theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Smooth Physics Dragging
    local dragging, dragInput, dragStart, startPos
    local targetPos = self.Shadow.Position

    self.TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = self.Shadow.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    RunService.RenderStepped:Connect(function(dt)
        if dragging and dragInput then
            local delta = dragInput.Position - dragStart
            targetPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
        -- Smooth Lerp
        self.Shadow.Position = self.Shadow.Position:Lerp(targetPos, dt * 15)
    end)

    -- Sidebar & Content Area
    self.Sidebar = Create("ScrollingFrame", {
        Parent = self.MainFrame,
        Size = UDim2.new(0, 160, 1, -50),
        Position = UDim2.new(0, 10, 0, 50),
        BackgroundTransparency = 1,
        ScrollBarThickness = 0,
    })
    self.SidebarLayout = Create("UIListLayout", {
        Parent = self.Sidebar,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder
    })

    self.ContentContainer = Create("Frame", {
        Parent = self.MainFrame,
        Size = UDim2.new(1, -190, 1, -60),
        Position = UDim2.new(0, 180, 0, 50),
        BackgroundTransparency = 1,
    })

    self.Tabs = {}
    return self
end

-- 📁 TAB CREATION
function MaddiSON:CreateTab(name, icon)
    local theme = GetTheme()
    
    local tab = {Elements = {}}
    
    local tabBtn = Create("TextButton", {
        Parent = self.Sidebar,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ClipsDescendants = true,
    })
    Create("UICorner", { Parent = tabBtn, CornerRadius = UDim.new(0, 8) })
    
    local indicator = Create("Frame", {
        Parent = tabBtn,
        Size = UDim2.new(0, 3, 0, 16),
        Position = UDim2.new(0, 4, 0.5, -8),
        BackgroundColor3 = theme.Accent,
        BackgroundTransparency = 1,
    })
    Create("UICorner", { Parent = indicator, CornerRadius = UDim.new(1, 0) })

    local tabText = Create("TextLabel", {
        Parent = tabBtn,
        Size = UDim2.new(1, -30, 1, 0),
        Position = UDim2.new(0, 20, 0, 0),
        BackgroundTransparency = 1,
        Text = (icon and icon .. "  " or "") .. name,
        TextColor3 = theme.TextMuted,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local page = Create("ScrollingFrame", {
        Parent = self.ContentContainer,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = theme.Stroke,
        Visible = false,
    })
    Create("UIPadding", { Parent = page, PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) })
    local pageLayout = Create("UIListLayout", {
        Parent = page,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder
    })

    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y)
    end)

    local function Activate()
        for _, t in ipairs(self.Tabs) do
            t.Page.Visible = false
            Tween(t.Btn, {BackgroundTransparency = 1})
            Tween(t.Text, {TextColor3 = theme.TextMuted})
            Tween(t.Indicator, {BackgroundTransparency = 1, Size = UDim2.new(0, 3, 0, 0), Position = UDim2.new(0, 4, 0.5, 0)})
        end
        page.Visible = true
        Tween(tabBtn, {BackgroundTransparency = 0.5})
        Tween(tabText, {TextColor3 = theme.Text})
        Tween(indicator, {BackgroundTransparency = 0, Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 4, 0.5, -8)})
    end

    tabBtn.MouseButton1Click:Connect(Activate)
    tabBtn.MouseEnter:Connect(function()
        if not page.Visible then Tween(tabBtn, {BackgroundTransparency = 0.8}) end
    end)
    tabBtn.MouseLeave:Connect(function()
        if not page.Visible then Tween(tabBtn, {BackgroundTransparency = 1}) end
    end)

    tab.Btn = tabBtn
    tab.Text = tabText
    tab.Indicator = indicator
    tab.Page = page
    table.insert(self.Tabs, tab)
    
    if #self.Tabs == 1 then Activate() end

    -- 🔘 ELEMENTS FACTORY
    function tab:AddButton(options)
        local text = options.Name or "Button"
        local callback = options.Callback or function() end
        local theme = GetTheme()

        local frame = Create("Frame", {
            Parent = page,
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = theme.Surface,
        })
        Create("UICorner", { Parent = frame, CornerRadius = UDim.new(0, 8) })
        local stroke = Create("UIStroke", { Parent = frame, Color = theme.Stroke, Thickness = 1 })

        local btn = Create("TextButton", {
            Parent = frame,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = theme.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = 14,
            ClipsDescendants = true,
        })

        btn.MouseEnter:Connect(function() 
            Tween(frame, {BackgroundColor3 = theme.SurfaceHover}) 
            Tween(stroke, {Color = theme.Accent, Transparency = 0.5})
        end)
        btn.MouseLeave:Connect(function() 
            Tween(frame, {BackgroundColor3 = theme.Surface}) 
            Tween(stroke, {Color = theme.Stroke, Transparency = 0})
        end)
        
        btn.MouseButton1Down:Connect(function()
            CreateRipple(btn, Mouse.X, Mouse.Y)
            Tween(frame, {Size = UDim2.new(1, -4, 0, 38)}, 0.1)
        end)
        btn.MouseButton1Up:Connect(function()
            Tween(frame, {Size = UDim2.new(1, 0, 0, 42)}, 0.1)
            callback()
        end)
    end

    function tab:AddToggle(options)
        local text = options.Name or "Toggle"
        local default = options.Default or false
        local callback = options.Callback or function() end
        local state = default
        local theme = GetTheme()

        local frame = Create("Frame", {
            Parent = page,
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = theme.Surface,
        })
        Create("UICorner", { Parent = frame, CornerRadius = UDim.new(0, 8) })
        Create("UIStroke", { Parent = frame, Color = theme.Stroke, Thickness = 1 })

        Create("TextLabel", {
            Parent = frame,
            Size = UDim2.new(1, -60, 1, 0),
            Position = UDim2.new(0, 15, 0, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = theme.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local switch = Create("Frame", {
            Parent = frame,
            Size = UDim2.new(0, 40, 0, 20),
            Position = UDim2.new(1, -55, 0.5, -10),
            BackgroundColor3 = state and theme.Accent or theme.Background,
        })
        Create("UICorner", { Parent = switch, CornerRadius = UDim.new(1, 0) })
        local switchStroke = Create("UIStroke", { Parent = switch, Color = theme.Stroke, Thickness = 1 })

        local circle = Create("Frame", {
            Parent = switch,
            Size = UDim2.new(0, 14, 0, 14),
            Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        })
        Create("UICorner", { Parent = circle, CornerRadius = UDim.new(1, 0) })

        local btn = Create("TextButton", {
            Parent = frame,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
        })

        local function SetState(newState)
            state = newState
            Tween(switch, {BackgroundColor3 = state and theme.Accent or theme.Background})
            Tween(switchStroke, {Color = state and theme.AccentGlow or theme.Stroke})
            Tween(circle, {Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)})
            callback(state)
        end

        btn.MouseButton1Click:Connect(function() SetState(not state) end)
        btn.MouseEnter:Connect(function() Tween(frame, {BackgroundColor3 = theme.SurfaceHover}) end)
        btn.MouseLeave:Connect(function() Tween(frame, {BackgroundColor3 = theme.Surface}) end)
    end

    function tab:AddSlider(options)
        local text = options.Name or "Slider"
        local min = options.Min or 0
        local max = options.Max or 100
        local default = options.Default or min
        local callback = options.Callback or function() end
        local value = default
        local theme = GetTheme()

        local frame = Create("Frame", {
            Parent = page,
            Size = UDim2.new(1, 0, 0, 55),
            BackgroundColor3 = theme.Surface,
        })
        Create("UICorner", { Parent = frame, CornerRadius = UDim.new(0, 8) })
        Create("UIStroke", { Parent = frame, Color = theme.Stroke, Thickness = 1 })

        Create("TextLabel", {
            Parent = frame,
            Size = UDim2.new(1, -30, 0, 25),
            Position = UDim2.new(0, 15, 0, 5),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = theme.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local valLabel = Create("TextLabel", {
            Parent = frame,
            Size = UDim2.new(0, 50, 0, 25),
            Position = UDim2.new(1, -65, 0, 5),
            BackgroundTransparency = 1,
            Text = tostring(value),
            TextColor3 = theme.Accent,
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Right,
        })

        local track = Create("Frame", {
            Parent = frame,
            Size = UDim2.new(1, -30, 0, 6),
            Position = UDim2.new(0, 15, 1, -15),
            BackgroundColor3 = theme.Background,
        })
        Create("UICorner", { Parent = track, CornerRadius = UDim.new(1, 0) })

        local fill = Create("Frame", {
            Parent = track,
            Size = UDim2.new((value - min)/(max - min), 0, 1, 0),
            BackgroundColor3 = theme.Accent,
        })
        Create("UICorner", { Parent = fill, CornerRadius = UDim.new(1, 0) })
        
        local knob = Create("Frame", {
            Parent = fill,
            Size = UDim2.new(0, 12, 0, 12),
            Position = UDim2.new(1, -6, 0.5, -6),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        })
        Create("UICorner", { Parent = knob, CornerRadius = UDim.new(1, 0) })

        local dragging = false
        local function Update(input)
            local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * percent)
            valLabel.Text = tostring(value)
            Tween(fill, {Size = UDim2.new(percent, 0, 1, 0)}, 0.1)
            callback(value)
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                Tween(knob, {Size = UDim2.new(0, 16, 0, 16, Position = UDim2.new(1, -8, 0.5, -8))}, 0.2)
                Update(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then Update(input) end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
                Tween(knob, {Size = UDim2.new(0, 12, 0, 12, Position = UDim2.new(1, -6, 0.5, -6))}, 0.2)
            end
        end)
    end

    return tab
end

return MaddiSON
