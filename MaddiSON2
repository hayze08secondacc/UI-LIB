local function CreatePage(name)
    local page = New("Frame", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 15
    }, PageContainer)

    New("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, page)

    Pages[name] = page
    return page
end

local function SelectPage(name)
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for buttonName, button in pairs(CategoryButtons) do
        local active = buttonName == name
        local indicator = button:FindFirstChild("Indicator")

        Tween(button, 0.18, {
            BackgroundColor3 = active and Theme.White or Theme.Element,
            TextColor3 = active and Theme.Black or Theme.TextSoft
        })

        if indicator then
            Tween(indicator, 0.18, {
                BackgroundTransparency = active and 0 or 1
            })
        end
    end

    local titles = {
        Overview = {
            "Overview",
            "A focused control surface for MaddiSON."
        },
        Controls = {
            "Controls",
            "Buttons, toggles, sliders and keybinds."
        },
        Appearance = {
            "Appearance",
            "Fine-tune the visual language of the interface."
        },
        Utilities = {
            "Utilities",
            "Small tools for managing the interface."
        }
    }

    PageTitle.Text = titles[name] and titles[name][1] or name
    PageSubtitle.Text = titles[name] and titles[name][2] or "MaddiSON interface module."
    CurrentPageName = name
end

