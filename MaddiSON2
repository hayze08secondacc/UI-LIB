-- LocalScript Example
local MaddiSON = loadstring(game:HttpGet("YOUR_RAW_SCRIPT_URL"))() -- Or require(path.to.module)

-- Initialize Main Window
MaddiSON:Init()

-- Create Tabs
local MainTab = MaddiSON:CreateTab("General", "⚡")
local VisualTab = MaddiSON:CreateTab("Visuals", "🎨")
local SettingsTab = MaddiSON:CreateTab("Settings", "⚙")

-- Send a Test Notification
MaddiSON:Notify({
    Title = "MaddiSON Loaded",
    Message = "Welcome to MaddiSON UI Library v2.0!",
    Type = "Success",
    Duration = 5
})

-- Add Elements to Main Tab
MainTab:AddButton({
    Name = "Execute Script",
    Callback = function()
        MaddiSON:Notify({
            Title = "Action Triggered",
            Message = "Executed action successfully!",
            Type = "Info",
            Duration = 3
        })
    end
})

MainTab:AddToggle({
    Name = "Enable Godmode",
    Default = false,
    Flag = "GodMode",
    Callback = function(state)
        print("Godmode status:", state)
    end
})

MainTab:AddSlider({
    Name = "WalkSpeed Multiplier",
    Min = 16,
    Max = 200,
    Default = 16,
    Flag = "WalkSpeed",
    Callback = function(val)
        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = val
        end
    end
})

-- Add Elements to Visuals Tab
VisualTab:AddDropdown({
    Name = "Select Theme",
    Options = {"Obsidian", "Midnight", "Crimson", "Emerald", "Cyber"},
    Default = "Obsidian",
    Callback = function(selectedTheme)
        MaddiSON:SetTheme(selectedTheme)
    end
})

-- Add Keybind to Settings Tab
SettingsTab:AddKeybind({
    Name = "Toggle GUI Key",
    Default = Enum.KeyCode.RightControl,
    Callback = function()
        MaddiSON.MainFrame.Visible = not MaddiSON.MainFrame.Visible
    end
})
