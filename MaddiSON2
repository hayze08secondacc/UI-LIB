function RicharliSON:CreateButton(parent, config)
    config = config or {}
    local text = config.Text or "Button"
    local color = config.Color or CurrentTheme.Primary
    local callback = config.Callback or function() end
    local width = config.Width or 140
    local height = config.Height or 40
    
    local btn = Instance.new("TextButton")
    btn.Name = config.Name or "Button"
    btn.Size = UDim2.new(0, width, 0, height)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = CurrentTheme.Text
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.ZIndex = 12
    btn.Parent = parent
    
    self:CreateCorner(btn, UDim.new(0, 10))
    self:CreateStroke(btn, Color3.fromRGB(255, 255, 255), 1, 0.8)
    
    -- Hover & Click
    btn.MouseEnter:Connect(function()
        self:Tween(btn, {Size = UDim2.new(0, width + 5, 0, height + 2)}, 0.2)
    end)
    
    btn.MouseLeave:Connect(function()
        self:Tween(btn, {Size = UDim2.new(0, width, 0, height)}, 0.2)
    end)
    
    btn.MouseButton1Down:Connect(function()
        self:Tween(btn, {Size = UDim2.new(0, width - 3, 0, height - 2)}, 0.1)
    end)
    
    btn.MouseButton1Up:Connect(function()
        self:Tween(btn, {Size = UDim2.new(0, width + 5, 0, height + 2)}, 0.1)
    end)
    
    btn.MouseButton1Click:Connect(function(x, y)
        self:RippleEffect(btn, Vector2.new(x, y))
        callback()
    end)
    
    return btn
end

