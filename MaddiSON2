function RicharliSON:CreateWindow(config)
    config = config or {}
    local title = config.Title or "RicharliSON"
    local size = config.Size or UDim2.new(0, 550, 0, 380)
    local pos = config.Position or UDim2.new(0.5, -275, 0.5, -190)
    local theme = config.Theme or "Default"
    
    self:SetTheme(theme)
    
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    
    -- ScreenGui
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = title .. "_UI"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = playerGui
    
    -- Frame principal
    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.Size = size
    mainFrame.Position = pos
    mainFrame.BackgroundColor3 = CurrentTheme.Background
    mainFrame.BorderSizePixel = 0
    mainFrame.ClipsDescendants = true
    mainFrame.ZIndex = 10
    mainFrame.Parent = screenGui
    
    self:CreateCorner(mainFrame, UDim.new(0, 16))
    
    -- Ombre
    local shadow = self:CreateShadow(mainFrame, 10, 0.65)
    
    -- Bordure glow animée
    local glowBorder = Instance.new("Frame")
    glowBorder.Name = "GlowBorder"
    glowBorder.Size = UDim2.new(1, 6, 1, 6)
    glowBorder.Position = UDim2.new(0, -3, 0, -3)
    glowBorder.BackgroundColor3 = CurrentTheme.Primary
    glowBorder.BorderSizePixel = 0
    glowBorder.ZIndex = 9
    glowBorder.Parent = mainFrame
    self:CreateCorner(glowBorder, UDim.new(0, 18))
    
    local glowGradient = self:CreateGradient(glowBorder, {
        CurrentTheme.Primary,
        CurrentTheme.Secondary,
        CurrentTheme.Accent,
        CurrentTheme.Primary
    }, 0)
    
    -- Animation rotation glow
    spawn(function()
        while glowGradient.Parent do
            for i = 0, 360, 2 do
                if not glowGradient.Parent then break end
                glowGradient.Rotation = i
                task.wait(0.016)
            end
        end
    end)
    
    -- Dégradé de fond
    self:CreateGradient(mainFrame, {
        CurrentTheme.Background,
        Color3.fromRGB(
            CurrentTheme.Background.R * 255 + 10,
            CurrentTheme.Background.G * 255 + 5,
            CurrentTheme.Background.B * 255 + 15
        ),
        CurrentTheme.Background
    }, 45)
    
    -- Barre de titre
    local titleBar = Instance.new("Frame")
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1, 0, 0, 55)
    titleBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    titleBar.BackgroundTransparency = 0.95
    titleBar.BorderSizePixel = 0
    titleBar.ZIndex = 11
    titleBar.Parent = mainFrame
    self:CreateCorner(titleBar, UDim.new(0, 16))
    
    -- Titre avec dégradé
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "Title"
    titleLabel.Size = UDim2.new(0, 350, 1, 0)
    titleLabel.Position = UDim2.new(0, 20, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = CurrentTheme.Text
    titleLabel.TextSize = 26
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 12
    titleLabel.Parent = titleBar
    
    self:CreateGradient(titleLabel, {CurrentTheme.Primary, CurrentTheme.Secondary}, 0)
    
    -- Boutons de contrôle
    local controls = {"Close", "Minimize"}
    local colors = {CurrentTheme.Error, CurrentTheme.Warning}
    local symbols = {"×", "−"}
    
    for i, control in ipairs(controls) do
        local btn = Instance.new("TextButton")
        btn.Name = control .. "Btn"
        btn.Size = UDim2.new(0, 32, 0, 32)
        btn.Position = UDim2.new(1, -42 * i, 0, 11)
        btn.BackgroundColor3 = colors[i]
        btn.Text = symbols[i]
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 20
        btn.Font = Enum.Font.GothamBold
        btn.ZIndex = 12
        btn.Parent = titleBar
        self:CreateCorner(btn, UDim.new(0, 8))
        
        -- Hover effects
        btn.MouseEnter:Connect(function()
            self:Tween(btn, {BackgroundTransparency = 0.3}, 0.2)
        end)
        btn.MouseLeave:Connect(function()
            self:Tween(btn, {BackgroundTransparency = 0}, 0.2)
        end)
    end
    
    local closeBtn = titleBar:FindFirstChild("CloseBtn")
    local minBtn = titleBar:FindFirstChild("MinimizeBtn")
    
    -- Contenu
    local contentFrame = Instance.new("Frame")
    contentFrame.Name = "Content"
    contentFrame.Size = UDim2.new(1, -30, 1, -65)
    contentFrame.Position = UDim2.new(0, 15, 0, 60)
    contentFrame.BackgroundTransparency = 1
    contentFrame.ZIndex = 11
    contentFrame.Parent = mainFrame
    
    local contentLayout = Instance.new("UIListLayout")
    contentLayout.Padding = UDim.new(0, 10)
    contentLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    contentLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    contentLayout.Parent = contentFrame
    
    -- Animation d'ouverture
    mainFrame.Size = UDim2.new(0, 0, 0, 0)
    mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    self:Tween(mainFrame, {Size = size, Position = pos}, 0.8, Enum.EasingStyle.Back)
    
    -- Drag & Drop
    local dragging = false
    local dragStart, startPos
    
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            mainFrame.Position = newPos
            shadow.Position = UDim2.new(newPos.X.Scale, newPos.X.Offset - 10, newPos.Y.Scale, newPos.Y.Offset - 10)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    -- Fermer
    closeBtn.MouseButton1Click:Connect(function()
        self:Tween(mainFrame, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        self:Tween(shadow, {Size = UDim2.new(0, 0, 0, 0)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In, function()
            screenGui:Destroy()
        end)
    end)
    
    -- Minimiser
    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            self:Tween(mainFrame, {Size = UDim2.new(0, size.X.Offset, 0, 55)}, 0.4)
            self:Tween(shadow, {Size = UDim2.new(0, size.X.Offset + 20, 0, 65)}, 0.4)
            contentFrame.Visible = false
            minBtn.Text = "+"
        else
            self:Tween(mainFrame, {Size = size}, 0.4)
            self:Tween(shadow, {Size = UDim2.new(0, size.X.Offset + 20, 0, size.Y.Offset + 20)}, 0.4)
            contentFrame.Visible = true
            minBtn.Text = "−"
        end
    end)
    
    local window = {
        Frame = mainFrame,
        Content = contentFrame,
        ScreenGui = screenGui,
        Theme = CurrentTheme
    }
    
    return window
end

