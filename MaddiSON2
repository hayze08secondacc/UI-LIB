local function CreateCategory(name, icon)
    local button = New("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Text = "   " .. icon .. "    " .. name,
        Font = Enum.Font.GothamSemibold,
        TextSize = 11,
        TextColor3 = Theme.SoftText,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        ZIndex = 34
    }, Navigation)

    Corner(button, 8)

    local indicator = New("Frame", {
        Name = "Indicator",
        Position = UDim2.fromOffset(0, 9),
        Size = UDim2.fromOffset(3, 20),
        BackgroundColor3 = Theme.Black,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 35
    }, button)

    Corner(indicator, 3)
    CategoryButtons[name] = button

    button.MouseEnter:Connect(function()
        if CurrentPageName ~= name then
            Tween(button, 0.15, {
                BackgroundColor3 = Theme.Hover,
                TextColor3 = Theme.Text
            })
        end
    end)

    button.MouseLeave:Connect(function()
        if CurrentPageName ~= name then
            Tween(button, 0.15, {
                BackgroundColor3 = Theme.Element,
                TextColor3 = Theme.SoftText
            })
        end
    end)

    button.MouseButton1Click:Connect(function()
        for pageName, page in pairs(Pages) do
            page.Visible = pageName == name
        end

        for buttonName, otherButton in pairs(CategoryButtons) do
            local active = buttonName == name
            local otherIndicator = otherButton:FindFirstChild("Indicator")

            Tween(otherButton, 0.18, {
                BackgroundColor3 = active and Theme.White or Theme.Element,
                TextColor3 = active and Theme.Black or Theme.SoftText
            })

            if otherIndicator then
                Tween(otherIndicator, 0.18, {
                    BackgroundTransparency = active and 0 or 1
                })
            end
        end

        local subtitles = {
            Overview = "A focused control surface for MaddiSON.",
            Controls = "Buttons, toggles, sliders and keybinds.",
            Appearance = "Fine-tune the visual language of the interface.",
            Utilities = "Small tools for managing the interface."
        }

        PageTitle.Text = name
        PageSubtitle.Text = subtitles[name] or "MaddiSON interface module."
        CurrentPageName = name
    end)

    return button
end

