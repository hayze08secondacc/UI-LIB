local function CreateSlider(parent, title, description, minimum, maximum, default, callback)
local row = CreateRow(parent, title, description)
local value = math.clamp(default or minimum, minimum, maximum)

local track = New("Frame", {
AnchorPoint = Vector2.new(1, 0.5),
Position = UDim2.new(1, -13, 0.5, 4),
Size = UDim2.fromOffset(135, 5),
BackgroundColor3 = Theme.Hover,
BorderSizePixel = 0,
ZIndex = 39
}, row)

Corner(track, 5)

local fill = New("Frame", {
Size = UDim2.fromScale((value - minimum) / (maximum - minimum), 1),
BackgroundColor3 = Theme.White,
BorderSizePixel = 0,
ZIndex = 40
}, track)

Corner(fill, 5)

local knob = New("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new((value - minimum) / (maximum - minimum), 0, 0.5, 0),
Size = UDim2.fromOffset(13, 13),
BackgroundColor3 = Theme.White,
BorderSizePixel = 0,
ZIndex = 41
}, track)

Corner(knob, 13)

local valueLabel = New("TextLabel", {
AnchorPoint = Vector2.new(1, 1),
Position = UDim2.new(1, 0, 0, -7),
Size = UDim2.fromOffset(135, 13),
BackgroundTransparency = 1,
Text = tostring(value),
Font = Enum.Font.GothamBold,
TextSize = 8,
TextColor3 = Theme.SoftText,
TextXAlignment = Enum.TextXAlignment.Right,
ZIndex = 42
}, row)

local draggingSlider = false

local function update(inputX)
local percent = math.clamp(
(inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X,
0,
1
)

value = math.floor(minimum + (maximum - minimum) * percent)
fill.Size = UDim2.fromScale(percent, 1)
knob.Position = UDim2.new(percent, 0, 0.5, 0)
valueLabel.Text = tostring(value)

if callback then callback(value) end
end

track.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1
or input.UserInputType == Enum.UserInputType.Touch then
draggingSlider = true
update(input.Position.X)
end
end)

UserInputService.InputChanged:Connect(function(input)
if draggingSlider and (
input.UserInputType == Enum.UserInputType.MouseMovement
or input.UserInputType == Enum.UserInputType.Touch
) then
update(input.Position.X)
end
end)

UserInputService.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1
or input.UserInputType == Enum.UserInputType.Touch then
draggingSlider = false
end
end)

return row
end

local function CreateDropdown(parent, title, description, options, default, callback)
    options = options or {}

    local row = CreateRow(parent, title, description)
    local selected = default or options[1]
    local opened = false

    local closedHeight = 46
    local optionHeight = 27
    local spacing = 5
    local openHeight = closedHeight + spacing + (#options * optionHeight)

    local dropdown = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 9),
        Size = UDim2.fromOffset(140, 28),
        BackgroundColor3 = Theme.Hover,
        BorderSizePixel = 0,
        Text = tostring(selected or "Select") .. " ▾",
        Font = Enum.Font.GothamSemibold,
        TextSize = 9,
        TextColor3 = Theme.Text,
        AutoButtonColor = false,
        ZIndex = 45
    }, row)

    Corner(dropdown, 7)
    Stroke(dropdown, Theme.Border, 1, 0.15)

local optionFrame = New("Frame", {
    Position = UDim2.new(0, 0, 1, 5),
    Size = UDim2.new(1, 0, 0, #options * 27),
    BackgroundColor3 = Theme.Surface,
    BorderSizePixel = 0,
    Visible = false,
    ZIndex = 70
}, dropdown)

Corner(optionFrame, 7)
Stroke(optionFrame, Theme.Border, 1, 0.1)

New("UIListLayout", {
    SortOrder = Enum.SortOrder.LayoutOrder
}, optionFrame)

    for _, option in ipairs(options) do
        local optionButton = New("TextButton", {
            Size = UDim2.new(1, 0, 0, optionHeight),
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,
            Text = tostring(option),
            Font = Enum.Font.Gotham,
            TextSize = 9,
            TextColor3 = Theme.SoftText,
            AutoButtonColor = false,
            ZIndex = 71
        }, optionFrame)

        optionButton.MouseButton1Click:Connect(function()
            selected = option
            dropdown.Text = tostring(selected) .. " ▾"
            opened = false
            optionFrame.Visible = false

            Tween(row, 0.25, {
                Size = UDim2.new(1, 0, 0, closedHeight)
            })

            if callback then
                callback(selected)
            end
        end)
    end

    dropdown.MouseButton1Click:Connect(function()
        opened = not opened
        optionFrame.Visible = opened

        Tween(row, 0.25, {
            Size = UDim2.new(
                1,
                0,
                0,
                opened and openHeight or closedHeight
            )
        })
    end)

    return row
end

local function CreateKeybind(parent, title, description, defaultKey, callback)
local row = CreateRow(parent, title, description)
local key = defaultKey or Enum.KeyCode.RightShift
local listening = false

local button = New("TextButton", {
AnchorPoint = Vector2.new(1, 0.5),
Position = UDim2.new(1, -12, 0.5, 0),
Size = UDim2.fromOffset(94, 28),
BackgroundColor3 = Theme.Hover,
BorderSizePixel = 0,
Text = key.Name,
Font = Enum.Font.GothamBold,
TextSize = 9,
TextColor3 = Theme.Text,
AutoButtonColor = false,
ZIndex = 39
}, row)

Corner(button, 7)
Stroke(button, Theme.Border, 1, 0.15)

button.MouseButton1Click:Connect(function()
listening = true
button.Text = "PRESS KEY"
end)

UserInputService.InputBegan:Connect(function(input, processed)
if processed then return end

if listening and input.UserInputType == Enum.UserInputType.Keyboard then
key = input.KeyCode
listening = false
button.Text = key.Name
elseif input.KeyCode == key and not listening then
if callback then callback() end
end
end)

return row
end

